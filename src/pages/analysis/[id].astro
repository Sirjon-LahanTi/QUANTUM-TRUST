---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';

const { id } = Astro.params;
---

<Layout title={`Analysis ${id}`} description={`Full security analysis report for document ID ${id}.`}>
  <Navigation slot="sidebar" />

  <div id="loading-state" aria-live="polite">
    <div class="empty-state">
      <span class="empty-state-icon" aria-hidden="true">⋯</span>
      <p class="empty-state-title">Loading analysis…</p>
    </div>
  </div>

  <div id="error-state" style="display:none;" aria-live="assertive">
    <div class="error-banner" id="error-msg"></div>
    <div style="margin-top:16px;">
      <a href="/dashboard" class="btn btn-secondary btn-sm">Back to Dashboard</a>
    </div>
  </div>

  <div id="analysis-content" style="display:none;">

    <!-- Page header (populated dynamically) -->
    <div class="page-header">
      <div style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:12px;">
        <div>
          <h1 class="page-title" id="doc-filename-title">Analysis</h1>
          <p class="page-subtitle" id="analysis-id-sub"></p>
        </div>
        <div id="verdict-badge-header"></div>
      </div>
    </div>

    <!-- Verdict -->
    <div class="section">
      <div id="verdict-display"></div>
    </div>

    <!-- WHY THIS VERDICT? Explainable Verification Section -->
    <div class="section" id="explainable-section">
      <div class="card" style="border-left: 3px solid var(--accent); background: var(--bg-surface); padding: var(--space-5);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-3);">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span class="section-title" style="margin: 0; font-size: 0.8125rem; letter-spacing: 0.05em; font-weight: 600; color: var(--text-primary);">
              WHY THIS VERDICT?
            </span>
            <span class="badge badge--neutral" id="exp-confidence-badge" style="font-size: 0.6875rem;">CONFIDENCE: —</span>
          </div>
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);">
            DETERMINISTIC VERIFICATION ENGINE
          </span>
        </div>

        <!-- Final Reason Callout -->
        <div id="exp-final-reason-box" style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4); margin-bottom: var(--space-4);">
          <div style="display: flex; align-items: flex-start; gap: 12px;">
            <span id="exp-verdict-icon" style="font-size: 1.25rem; line-height: 1;">•</span>
            <div>
              <div style="font-family: 'Inter', sans-serif; font-size: var(--text-base); color: var(--text-primary); font-weight: 500; line-height: 1.5;" id="exp-final-reason-text">
                Loading explanation…
              </div>
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-secondary); margin-top: 6px;" id="exp-summary-text">
              </div>
            </div>
          </div>
        </div>

        <!-- Two Column Trace & Evidence -->
        <div class="exp-grid" style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: var(--space-4); margin-bottom: var(--space-3);">
          <!-- Verification Trace -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              VERIFICATION TRACE
            </div>
            <div id="exp-trace-list" style="display: flex; flex-direction: column; gap: 8px;">
            </div>
          </div>

          <!-- Technical Evidence Summary -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              TECHNICAL EVIDENCE
            </div>
            <dl class="kv-list" id="exp-evidence-kv" style="margin: 0;"></dl>
          </div>
        </div>

        <!-- Methodology note -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--border-subtle); padding-top: var(--space-2); margin-top: var(--space-2);">
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);" id="exp-methodology-text">
            Deterministic rule-based explanation derived from cryptographic verification evidence.
          </span>
          <span class="badge badge--neutral" style="font-size: 0.625rem; font-family: 'IBM Plex Mono', monospace;">No AI / Pure Evidence</span>
        </div>
      </div>
    </div>


    <div class="detail-grid">
      <!-- Left column -->
      <div class="detail-col">

        <div class="section">
          <div class="section-title">Document</div>
          <div class="card">
            <dl class="kv-list" id="doc-info"></dl>
          </div>
        </div>

        <div class="section">
          <div class="section-title">Digital Signature</div>
          <div class="card">
            <dl class="kv-list" id="sig-info"></dl>
          </div>
        </div>

        <div class="section">
          <div class="section-title">Cryptography</div>
          <div class="card">
            <dl class="kv-list" id="crypto-info"></dl>
          </div>
        </div>

        <div class="section">
          <div class="section-title">Document Integrity</div>
          <div class="card">
            <dl class="kv-list" id="integrity-info"></dl>
          </div>
        </div>

      </div>

      <!-- Right column -->
      <div class="detail-col">

        <div class="section">
          <div class="section-title">Certificate</div>
          <div class="card">
            <dl class="kv-list" id="cert-info"></dl>
          </div>
        </div>

        <div class="section">
          <div class="section-title">Duplicate Detection</div>
          <div class="card">
            <dl class="kv-list" id="dup-info"></dl>
          </div>
        </div>

        <div class="section">
          <div class="section-title">Threat Analysis</div>
          <div class="card">
            <div class="threat-score-row">
              <span class="threat-num" id="threat-num">—</span>
              <span style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-sm);color:var(--text-muted)">&nbsp;/ 100</span>
              <span id="threat-badge" style="margin-left:8px;"></span>
            </div>
            <div class="threat-score-bar" style="margin-top:8px;margin-bottom:12px;">
              <div class="threat-score-fill" id="threat-fill" style="width:0%"></div>
            </div>
            <div id="threats-list"></div>
          </div>
        </div>

        <div class="section">
          <div class="section-title" style="display:flex;align-items:center;gap:8px;">
            QUANTUM-INSPIRED ANALYSIS
            <span class="badge badge--accent" style="font-size:0.625rem;">Classical Simulation</span>
          </div>
          <div class="quantum-grid" id="quantum-grid"></div>
          <p style="font-size:var(--text-xs);color:var(--text-muted);margin-top:10px;font-family:'IBM Plex Mono',monospace;">
            Classical simulation of quantum-inspired mathematical representations used as an additional security signal.
          </p>
        </div>

      </div>
    </div>

    <!-- TAMPERING LOCALIZATION -->
    <div class="section" id="tampering-localization-section" style="margin-top: var(--space-6);">
      <div class="card" style="border-top: 3px solid var(--accent); background: var(--bg-surface); padding: var(--space-5);">
        
        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-4); border-bottom: 1px solid var(--border-subtle); padding-bottom: var(--space-3);">
          <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <span class="section-title" style="margin: 0; font-size: 0.875rem; letter-spacing: 0.05em; font-weight: 600; color: var(--text-primary);">
              TAMPERING LOCALIZATION
            </span>
            <span class="badge badge--neutral" id="loc-status-badge">STATUS: —</span>
            <span class="badge badge--neutral" id="loc-level-badge">LEVEL: —</span>
            <span class="badge badge--neutral" id="loc-confidence-badge">CONFIDENCE: —</span>
          </div>
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);">
            FORMAT-AWARE STRUCTURAL LOCALIZATION
          </span>
        </div>

        <!-- Metrics Strip -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-4);">
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-3);">
            <div style="font-size: var(--text-xs); color: var(--text-secondary); font-family: 'IBM Plex Mono', monospace;">TAMPERING STATUS</div>
            <div style="font-size: var(--text-base); font-weight: 600; color: var(--text-primary); margin-top: 2px;" id="loc-status-val">—</div>
          </div>
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-3);">
            <div style="font-size: var(--text-xs); color: var(--text-secondary); font-family: 'IBM Plex Mono', monospace;">LOCALIZATION LEVEL</div>
            <div style="font-size: var(--text-base); font-weight: 600; color: var(--text-primary); margin-top: 2px;" id="loc-level-val">—</div>
          </div>
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-3);">
            <div style="font-size: var(--text-xs); color: var(--text-secondary); font-family: 'IBM Plex Mono', monospace;">AFFECTED LOCATIONS</div>
            <div style="font-size: var(--text-base); font-weight: 600; color: var(--text-primary); margin-top: 2px;" id="loc-count-val">0</div>
          </div>
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-3);">
            <div style="font-size: var(--text-xs); color: var(--text-secondary); font-family: 'IBM Plex Mono', monospace;">COMPARISON BASELINE</div>
            <div style="font-size: var(--text-base); font-weight: 600; color: var(--text-primary); margin-top: 2px;" id="loc-baseline-val">—</div>
          </div>
        </div>

        <!-- Narrative Summary Box -->
        <div id="loc-summary-box" style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4); margin-bottom: var(--space-4);">
          <div style="display: flex; align-items: flex-start; gap: 12px;">
            <span id="loc-summary-icon" style="font-size: 1.25rem; line-height: 1;">•</span>
            <div>
              <div style="font-family: 'Inter', sans-serif; font-size: var(--text-sm); color: var(--text-primary); font-weight: 500; line-height: 1.5;" id="loc-summary-text">
                Loading tampering localization analysis…
              </div>
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-secondary); margin-top: 4px;" id="loc-target-text"></div>
            </div>
          </div>
        </div>

        <!-- Affected Locations List -->
        <div id="loc-items-container" style="margin-bottom: var(--space-4);">
          <!-- Rendered dynamically -->
        </div>

        <!-- Limitations / Format Disclosures -->
        <div id="loc-limitations-box" style="display:none; background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4); margin-bottom: var(--space-3);">
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-2); letter-spacing: 0.04em;">
            FORMAT LOCALIZATION LIMITATIONS &amp; BASELINE DISCLOSURES
          </div>
          <div id="loc-limitations-list" style="display: flex; flex-direction: column; gap: 6px;"></div>
        </div>

        <!-- Informational footer note -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--border-subtle); padding-top: var(--space-2); margin-top: var(--space-2);">
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);">
            Deterministic Evidence Rule: QuantumTrust reports exact locations only when supported by verifiable structural/cryptographic evidence.
          </span>
          <span class="badge badge--neutral" style="font-size: 0.625rem; font-family: 'IBM Plex Mono', monospace;">Anti-Fabrication Engine</span>
        </div>

      </div>
    </div>

    <!-- SIGNATURE TIMELINE & REVISION HISTORY -->
    <div class="section" id="sig-timeline-section" style="margin-top: var(--space-6);">
      <div class="card" style="border-top: 3px solid var(--accent); background: var(--bg-surface); padding: var(--space-5);">

        
        <!-- Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-4); border-bottom: 1px solid var(--border-subtle); padding-bottom: var(--space-3);">
          <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <span class="section-title" style="margin: 0; font-size: 0.875rem; letter-spacing: 0.05em; font-weight: 600; color: var(--text-primary);">
              SIGNATURE TIMELINE &amp; REVISION HISTORY
            </span>
            <span class="badge badge--neutral" id="tl-consistency-badge">CONSISTENCY: —</span>
            <span class="badge badge--neutral" id="tl-order-confidence-badge">ORDER CONFIDENCE: —</span>
            <span class="badge badge--neutral" id="tl-stats-badge">0 SIGNATURES</span>
          </div>
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);">
            PDF INCREMENTAL REVISION AUDIT
          </span>
        </div>

        <!-- Timeline Overview Strip / Metrics -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(160px, 1fr)); gap: var(--space-3); margin-bottom: var(--space-4);">
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-3);">
            <div style="font-size: var(--text-xs); color: var(--text-secondary); font-family: 'IBM Plex Mono', monospace;">SIGNATURE FIELDS</div>
            <div style="font-size: var(--text-lg); font-weight: 600; color: var(--text-primary); margin-top: 2px;" id="tl-fields-count">—</div>
          </div>
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-3);">
            <div style="font-size: var(--text-xs); color: var(--text-secondary); font-family: 'IBM Plex Mono', monospace;">SIGNED SIGNATURES</div>
            <div style="font-size: var(--text-lg); font-weight: 600; color: var(--text-primary); margin-top: 2px;" id="tl-signed-count">—</div>
          </div>
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-3);">
            <div style="font-size: var(--text-xs); color: var(--text-secondary); font-family: 'IBM Plex Mono', monospace;">PDF REVISIONS</div>
            <div style="font-size: var(--text-lg); font-weight: 600; color: var(--text-primary); margin-top: 2px;" id="tl-revisions-count">—</div>
          </div>
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-3);">
            <div style="font-size: var(--text-xs); color: var(--text-secondary); font-family: 'IBM Plex Mono', monospace;">TIMELINE INTEGRITY</div>
            <div style="font-size: var(--text-lg); font-weight: 600; color: var(--text-primary); margin-top: 2px;" id="tl-status-val">—</div>
          </div>
        </div>

        <!-- Vertical Timeline Container -->
        <div id="timeline-tree-container" style="margin-bottom: var(--space-4);">
          <!-- Rendered dynamically -->
        </div>

        <!-- Timeline Findings Container -->
        <div id="timeline-findings-container" style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4); margin-bottom: var(--space-3);">
          <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
            TIMELINE &amp; REVISION FINDINGS
          </div>
          <div id="timeline-findings-list" style="display: flex; flex-direction: column; gap: 8px;"></div>
        </div>

        <!-- Informational footer note -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--border-subtle); padding-top: var(--space-2); margin-top: var(--space-2);">
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);">
            Standard Notice: PDFs legitimately support multiple signatures across incremental revisions; multiple signatures do not signify tampering unless signed byte ranges are violated.
          </span>
          <span class="badge badge--neutral" style="font-size: 0.625rem; font-family: 'IBM Plex Mono', monospace;">ISO 32000-1 / PAdES</span>
        </div>

      </div>
    </div>

    <!-- CERTIFICATE & PUBLIC KEY INSPECTOR -->
    <div class="section" id="cert-inspector-section" style="margin-top: var(--space-6);">
      <div class="card" style="border-top: 3px solid var(--accent); background: var(--bg-surface); padding: var(--space-5);">
        
        <!-- Section Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-4); border-bottom: 1px solid var(--border-subtle); padding-bottom: var(--space-3);">
          <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <span class="section-title" style="margin: 0; font-size: 0.875rem; letter-spacing: 0.05em; font-weight: 600; color: var(--text-primary);">
              CERTIFICATE &amp; PUBLIC KEY INSPECTOR
            </span>
            <span class="badge badge--neutral" id="cert-status-badge">STATUS: —</span>
            <span class="badge badge--neutral" id="cert-trust-badge">TRUST: —</span>
            <span class="badge badge--neutral" id="key-strength-badge">KEY: —</span>
          </div>
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);">
            X.509 PKI SPECIFICATION
          </span>
        </div>

        <!-- 3-Column Inspection Grid -->
        <div class="cert-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-4);">
          
          <!-- Column 1: Identity & Signer -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              SIGNER &amp; ISSUER IDENTITY
            </div>
            <dl class="kv-list" id="cert-identity-kv" style="margin: 0;"></dl>
          </div>

          <!-- Column 2: Public Key & Cryptography -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              PUBLIC KEY &amp; CRYPTOGRAPHY
            </div>
            <dl class="kv-list" id="cert-crypto-kv" style="margin: 0;"></dl>
          </div>

          <!-- Column 3: Fingerprint & Extensions -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              FINGERPRINT &amp; EXTENSIONS
            </div>
            <dl class="kv-list" id="cert-extensions-kv" style="margin: 0;"></dl>
          </div>

        </div>

        <!-- Certificate Chain & Security Findings -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-3);">
          <!-- Certificate Chain Trace -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              CERTIFICATE CHAIN TRACE
            </div>
            <div id="cert-chain-list" style="display: flex; flex-direction: column; gap: 8px;"></div>
          </div>

          <!-- Evidence-Based Security Findings -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              CERTIFICATE SECURITY FINDINGS
            </div>
            <div id="cert-findings-list" style="display: flex; flex-direction: column; gap: 8px;"></div>
          </div>
        </div>

        <!-- Fingerprint Disclaimer Notice -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--border-subtle); padding-top: var(--space-2); margin-top: var(--space-2);">
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);">
            Notice: Certificate fingerprint identifies this certificate; it is not the document authenticity proof.
          </span>
          <span class="badge badge--neutral" style="font-size: 0.625rem; font-family: 'IBM Plex Mono', monospace;">X.509 v3 Standard</span>
        </div>
      </div>
    </div>

    <!-- Actions -->
    <div class="section" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:var(--space-6);">
      <button class="btn btn-secondary" id="report-btn">Generate Report</button>
      <a href="/security" id="security-link" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        Open Security Dashboard
      </a>
      <a href="/dashboard" target="_blank" rel="noopener noreferrer" class="btn btn-secondary">
        Back to Dashboard
      </a>
      <button class="btn btn-danger" id="delete-analysis-btn" style="margin-left:auto;cursor:pointer;">
        Delete Analysis
      </button>
    </div>
  </div>
</Layout>

<script define:vars={{ analysisId: id }}>
  const API = window.PUBLIC_API_URL || 'http://localhost:8000';

  async function load() {
    try {
      const res = await fetch(`${API}/api/analysis/${analysisId}`);
      if (res.ok) {
        const r = await res.json();
        try { localStorage.setItem('qt_analysis_' + analysisId, JSON.stringify(r)); } catch (_) {}
        document.getElementById('loading-state').style.display = 'none';
        render(r);
        document.getElementById('analysis-content').style.display = 'block';
        return;
      }
    } catch (err) {
      console.warn('API detail fetch failed, trying local storage cache:', err);
    }

    try {
      const cached = localStorage.getItem('qt_analysis_' + analysisId);
      if (cached) {
        const r = JSON.parse(cached);
        document.getElementById('loading-state').style.display = 'none';
        render(r);
        document.getElementById('analysis-content').style.display = 'block';
        return;
      }
    } catch (_) {}

    document.getElementById('loading-state').style.display = 'none';
    document.getElementById('error-msg').textContent = `Failed to load analysis: Analysis ID "${analysisId}" not found.`;
    document.getElementById('error-state').style.display = 'block';
  }

  function render(r) {
    const doc = r.document ?? {};
    document.getElementById('doc-filename-title').textContent = doc.filename ?? 'Analysis';
    document.getElementById('analysis-id-sub').textContent = `Analysis ID: ${r.analysis_id ?? analysisId}`;

    // Verdict
    const verdict = (r.verdict ?? 'UNKNOWN').toUpperCase();
    const vClass  = verdict === 'AUTHENTIC' ? 'authentic' : verdict === 'TAMPERED' ? 'tampered' : verdict === 'SUSPICIOUS' ? 'suspicious' : '';
    const vBadge  = verdict === 'AUTHENTIC' ? 'ok' : verdict === 'TAMPERED' ? 'danger' : verdict === 'SUSPICIOUS' ? 'warn' : 'neutral';
    document.getElementById('verdict-badge-header').innerHTML = `<span class="badge badge--${vBadge}">${verdict}</span>`;
    document.getElementById('verdict-display').innerHTML = `
      <div class="verdict-banner ${vClass}" role="status">
        <span class="verdict-word">${verdict}</span>
        <div class="verdict-sublabel">Final Security Verdict</div>
      </div>`;

    // ── Explainable Verification Section ─────────────────────────────────────
    const exp = r.explainable_verification ?? {};
    const conf = (exp.confidence ?? 'HIGH').toUpperCase();
    const confBadge = conf === 'HIGH' ? 'ok' : conf === 'MEDIUM' ? 'warn' : 'neutral';
    const confEl = document.getElementById('exp-confidence-badge');
    if (confEl) {
      confEl.className = `badge badge--${confBadge}`;
      confEl.textContent = `CONFIDENCE: ${conf}`;
    }

    const iconEl = document.getElementById('exp-verdict-icon');
    if (iconEl) {
      iconEl.textContent = verdict === 'AUTHENTIC' ? '✓' : verdict === 'TAMPERED' ? '✕' : '⚠';
      iconEl.style.color = verdict === 'AUTHENTIC' ? 'var(--ok)' : verdict === 'TAMPERED' ? 'var(--danger)' : 'var(--warn)';
    }

    const reasonEl = document.getElementById('exp-final-reason-text');
    if (reasonEl) {
      reasonEl.textContent = exp.final_reason || (
        verdict === 'AUTHENTIC'
          ? 'Digital signature verification succeeded and the signed content passed integrity validation.'
          : verdict === 'TAMPERED'
          ? 'Cryptographic verification failed because the signed content does not validate against the existing signature.'
          : 'The digital signature is present, but certificate, integrity, or structural checks produced warnings.'
      );
    }

    const sumEl = document.getElementById('exp-summary-text');
    if (sumEl) {
      sumEl.textContent = exp.summary || `Executive summary: Document classified as ${verdict}.`;
    }

    // Render Verification Trace
    const traceEl = document.getElementById('exp-trace-list');
    if (traceEl) {
      const steps = exp.verification_steps ?? [];
      if (steps.length === 0) {
        traceEl.innerHTML = `<div style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);color:var(--text-muted);">No trace steps recorded.</div>`;
      } else {
        traceEl.innerHTML = steps.map((st) => {
          const status = (st.status || 'PASS').toUpperCase();
          const sIcon = status === 'PASS' ? '✓' : status === 'FAIL' ? '✕' : status === 'WARNING' ? '⚠' : '—';
          const sColor = status === 'PASS' ? 'var(--ok)' : status === 'FAIL' ? 'var(--danger)' : status === 'WARNING' ? 'var(--warn)' : 'var(--text-muted)';
          return `
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); padding: 4px 0; border-bottom: 1px solid var(--border-subtle);">
              <div style="display: flex; align-items: flex-start; gap: 8px;">
                <span style="color: ${sColor}; font-weight: bold; flex-shrink: 0; width: 14px;">${sIcon}</span>
                <div>
                  <span style="color: var(--text-primary); font-weight: 500;">${st.check}</span>
                  ${st.observed_value ? `<span style="color: var(--text-muted); margin-left: 6px;">[${st.observed_value}]</span>` : ''}
                  ${st.explanation ? `<div style="color: var(--text-secondary); font-size: 0.6875rem; margin-top: 2px;">${st.explanation}</div>` : ''}
                </div>
              </div>
              <span class="badge badge--${status === 'PASS' ? 'ok' : status === 'FAIL' ? 'danger' : status === 'WARNING' ? 'warn' : 'neutral'}" style="font-size: 0.625rem;">
                ${status}
              </span>
            </div>
          `;
        }).join('');
      }
    }

    // Render Technical Evidence Table
    const evKv = document.getElementById('exp-evidence-kv');
    if (evKv) {
      const s = r.signature ?? {};
      const c = r.certificate ?? {};
      const intg = r.integrity ?? {};
      evKv.innerHTML = kvRows([
        ['Digest Algorithm',     s.digest_algorithm     ?? 'Not detected', true],
        ['Signature Algorithm',  s.signature_algorithm  ?? 'Not detected', true],
        ['Public Key Scheme',    s.public_key_algorithm ? `${s.public_key_algorithm} (${s.key_size ?? '?'} bits)` : 'Not detected', true],
        ['Certificate Trust',    c.trust_status         ?? 'UNAVAILABLE'],
        ['ByteRange Validity',   Array.isArray(intg.byte_range) && intg.byte_range.length ? 'Valid Range' : 'No Range', true],
        ['Document Integrity',   intg.status            ?? 'UNKNOWN'],
      ]);
    }

    const methEl = document.getElementById('exp-methodology-text');
    if (methEl && exp.methodology) {
      methEl.textContent = exp.methodology;
    }

    // Document
    document.getElementById('doc-info').innerHTML = kvRows([
      ['Filename', doc.filename ?? '—'],
      ['File Size', doc.file_size ? formatBytes(doc.file_size) : '—'],
      ['PDF Version', doc.pdf_version ?? '—'],
      ['Fingerprint', doc.fingerprint ?? 'Not available', true],
    ]);


    // Signature
    const s = r.signature ?? {};
    const sigS = s.status ?? 'UNKNOWN';
    const sigC = sigS === 'VALID' ? 'ok' : sigS === 'INVALID' ? 'danger' : 'neutral';
    document.getElementById('sig-info').innerHTML = kvRows([
      ['Present', s.present ? 'Yes' : 'No'],
      ['Count', s.count != null ? String(s.count) : '—'],
      ['Status', `<span class="badge badge--${sigC}">${sigS}</span>`],
      ['Type', s.signature_type ?? '—'],
    ]);

    // Crypto
    document.getElementById('crypto-info').innerHTML = kvRows([
      ['Digest Algorithm',     s.digest_algorithm     ?? '—', true],
      ['Signature Algorithm',  s.signature_algorithm  ?? '—', true],
      ['Public Key Algorithm', s.public_key_algorithm ?? '—', true],
      ['Key Size',             s.key_size != null ? `${s.key_size} bits` : '—'],
    ]);

    // Certificate
    const c = r.certificate ?? {};
    const tS = c.trust_status ?? 'Unknown';
    const tC = tS === 'TRUSTED' ? 'ok' : tS === 'UNTRUSTED' ? 'danger' : 'neutral';
    document.getElementById('cert-info').innerHTML = kvRows([
      ['Subject', c.subject ?? '—'],
      ['Issuer',  c.issuer  ?? '—'],
      ['Serial',  c.serial_number ?? '—', true],
      ['Valid From',  c.valid_from  ?? '—'],
      ['Valid Until', c.valid_until ?? '—'],
      ['Trust Status', `<span class="badge badge--${tC}">${tS}</span>`],
    ]);

    // Integrity
    const intg = r.integrity ?? {};
    const iS  = intg.status ?? 'UNKNOWN';
    const iC  = iS === 'VERIFIED' ? 'ok' : iS === 'FAILED' ? 'danger' : 'neutral';
    document.getElementById('integrity-info').innerHTML = kvRows([
      ['Status', `<span class="badge badge--${iC}">${iS}</span>`],
      ['Modification', intg.modification_status ?? '—'],
      ['ByteRange', Array.isArray(intg.byte_range) && intg.byte_range.length
          ? intg.byte_range.join(', ') : '—', true],
    ]);

    // Duplicate
    const dup = r.duplicate ?? {};
    const isDup = Boolean(dup.is_duplicate) ||
      (r.verdict && r.verdict.toUpperCase() === 'TAMPERED') ||
      (intg.status && intg.status.toUpperCase() === 'FAILED') ||
      (intg.modification_status && intg.modification_status.toUpperCase() === 'MODIFIED');
    const matchType = isDup
      ? (dup.match_type && dup.match_type !== 'NONE' ? dup.match_type : 'TAMPERED_DUPLICATE')
      : (dup.match_type ?? 'None');

    document.getElementById('dup-info').innerHTML = kvRows([
      ['Is Duplicate', isDup ? 'Yes' : 'No'],
      ['Match Type',   matchType],
    ]);

    // Threat
    const sec   = r.security ?? {};
    const score = sec.threat_score ?? 0;
    const level = (sec.threat_level ?? 'UNKNOWN').toUpperCase();
    const lClass = level === 'LOW' ? 'ok' : level === 'CRITICAL' ? 'danger' : 'warn';
    const fColor = score < 30 ? 'var(--ok)' : score < 60 ? 'var(--warn)' : 'var(--danger)';
    document.getElementById('threat-num').textContent = String(score);
    document.getElementById('threat-badge').innerHTML = `<span class="badge badge--${lClass}">${level}</span>`;
    document.getElementById('threat-fill').style.width = `${score}%`;
    document.getElementById('threat-fill').style.background = fColor;

    const threats = sec.detected_threats ?? [];
    document.getElementById('threats-list').innerHTML = threats.length === 0
      ? `<p style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);color:var(--text-muted);">No threats detected</p>`
      : `<ul style="list-style:none;display:flex;flex-direction:column;gap:6px;">${threats.map(t =>
          `<li style="display:flex;align-items:center;gap:8px;font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);color:var(--danger);">
            <span style="width:6px;height:6px;border-radius:50%;background:var(--danger);flex-shrink:0;display:inline-block"></span>${t}
           </li>`).join('')}</ul>`;

    // Quantum
    const q = r.quantum_analysis ?? {};
    const qMetrics = ['state_similarity','correlation_score','disturbance_score','anomaly_distance','entropy'];
    const qLabels  = ['State Similarity','Correlation Score','Disturbance Score','Anomaly Distance','Entropy'];
    document.getElementById('quantum-grid').innerHTML = qMetrics.map((k, i) => {
      const v = q[k]; const d = v != null ? Number(v).toFixed(4) : '—';
      return `<div class="quantum-metric">
        <span class="quantum-metric-label">${qLabels[i]}</span>
        <span class="quantum-metric-value">${d}</span>
      </div>`;
    }).join('');

    // ── Tampering Localization Engine ─────────────────────────────────────
    renderTamperingLocalization(r);

    // ── Signature Timeline & Revision History ──────────────────────────────
    renderSignatureTimeline(r);

    // ── Certificate & Public Key Inspector ───────────────────────────────────
    renderCertificateInspector(r);

    // Report button & security link
    document.getElementById('report-btn').onclick = () =>
      window.open(`${API}/api/analysis/${r.analysis_id}/report`, '_blank', 'noopener,noreferrer');
    document.getElementById('security-link').href = `/security?id=${r.analysis_id}`;

    // Delete button
    const delBtn = document.getElementById('delete-analysis-btn');
    if (delBtn) {
      delBtn.onclick = async () => {
        const confirmed = window.confirm(`Are you sure you want to delete this analysis (${r.document?.filename || r.analysis_id})?`);
        if (!confirmed) return;
        try {
          const res = await fetch(`${API}/api/analysis/${r.analysis_id}`, { method: 'DELETE' });
          if (!res.ok) throw new Error(`Delete failed: HTTP ${res.status}`);
          alert('Analysis deleted successfully.');
          window.location.href = '/analysis';
        } catch (err) {
          alert('Error deleting analysis: ' + (err.message || err));
        }
      };
    }
  }

  function renderTamperingLocalization(r) {
    const loc = r.tampering_localization ?? {};
    const status = (loc.status ?? 'NOT_AVAILABLE').toUpperCase();
    const level = (loc.localization_level ?? 'NOT_AVAILABLE').toUpperCase();
    const conf = (loc.confidence ?? 'UNKNOWN').toUpperCase();
    const isTampered = Boolean(loc.tampering_detected);
    const baseline = loc.comparison_source ?? 'NO_TRUSTED_BASELINE';
    const items = loc.affected_items ?? [];
    const limitations = loc.limitations ?? [];
    const findings = loc.findings ?? [];

    // Header Badges
    const statusClass = isTampered ? 'danger' : status === 'NO_TAMPERING_DETECTED' ? 'ok' : 'neutral';
    const statusBadge = document.getElementById('loc-status-badge');
    if (statusBadge) {
      statusBadge.className = `badge badge--${statusClass}`;
      statusBadge.textContent = isTampered ? 'TAMPERING DETECTED' : (status === 'NO_TAMPERING_DETECTED' ? 'NO TAMPERING' : status);
    }

    const levelBadge = document.getElementById('loc-level-badge');
    if (levelBadge) {
      levelBadge.className = `badge badge--${level !== 'NOT_AVAILABLE' && level !== 'NONE' ? 'accent' : 'neutral'}`;
      levelBadge.textContent = `LEVEL: ${level}`;
    }

    const confBadge = document.getElementById('loc-confidence-badge');
    if (confBadge) {
      const confClass = conf === 'HIGH' ? 'ok' : conf === 'MEDIUM' ? 'warn' : 'neutral';
      confBadge.className = `badge badge--${confClass}`;
      confBadge.textContent = `CONFIDENCE: ${conf}`;
    }

    // KPI Metrics
    const statusVal = document.getElementById('loc-status-val');
    if (statusVal) {
      statusVal.textContent = isTampered ? 'TAMPERING DETECTED' : (status === 'NO_TAMPERING_DETECTED' ? 'INTACT / AUTHENTIC' : 'NOT AVAILABLE');
      statusVal.style.color = isTampered ? 'var(--danger)' : (status === 'NO_TAMPERING_DETECTED' ? 'var(--ok)' : 'var(--text-primary)');
    }

    const levelVal = document.getElementById('loc-level-val');
    if (levelVal) levelVal.textContent = level;

    const countVal = document.getElementById('loc-count-val');
    if (countVal) countVal.textContent = `${items.length} Location(s)`;

    const baseVal = document.getElementById('loc-baseline-val');
    if (baseVal) baseVal.textContent = baseline.replace(/_/g, ' ');

    // Narrative Summary Box
    const sumIcon = document.getElementById('loc-summary-icon');
    if (sumIcon) {
      sumIcon.textContent = isTampered ? '✕' : (status === 'NO_TAMPERING_DETECTED' ? '✓' : 'ℹ');
      sumIcon.style.color = isTampered ? 'var(--danger)' : (status === 'NO_TAMPERING_DETECTED' ? 'var(--ok)' : 'var(--accent)');
    }

    const sumText = document.getElementById('loc-summary-text');
    if (sumText) {
      sumText.textContent = loc.summary || (
        isTampered
          ? `Structural tampering was identified across ${items.length} affected document component(s).`
          : (status === 'NO_TAMPERING_DETECTED'
              ? 'No structural modifications were detected relative to the signed cryptographic baseline.'
              : 'Structural tampering localization is not available for this document format or baseline.')
      );
    }

    const targetText = document.getElementById('loc-target-text');
    if (targetText) {
      const targetParts = [];
      if (loc.affected_revision) targetParts.push(`Affected Revision: ${loc.affected_revision}`);
      if (loc.affected_signature) targetParts.push(`Affected Signature: ${loc.affected_signature}`);
      targetText.textContent = targetParts.join(' | ');
    }

    // Items Container
    const itemsContainer = document.getElementById('loc-items-container');
    if (itemsContainer) {
      if (status === 'NO_TAMPERING_DETECTED') {
        itemsContainer.innerHTML = `
          <div style="background: var(--bg-surface); border: 1px solid var(--border); border-left: 3px solid var(--ok); border-radius: 4px; padding: var(--space-4);">
            <div style="display: flex; align-items: center; gap: 10px;">
              <span style="color: var(--ok); font-weight: bold; font-size: 1.125rem;">✓</span>
              <div>
                <div style="font-family: 'Inter', sans-serif; font-size: var(--text-sm); font-weight: 600; color: var(--text-primary);">
                  Document Content Intact &amp; Verified
                </div>
                <div style="font-size: var(--text-xs); color: var(--text-secondary); margin-top: 2px;">
                  The cryptographic signature covers the document bytes and no unauthorized modifications were detected.
                </div>
              </div>
            </div>
          </div>
        `;
      } else if (items.length === 0) {
        itemsContainer.innerHTML = `
          <div style="background: var(--bg-surface); border: 1px dashed var(--border); border-radius: 4px; padding: var(--space-4); text-align: center;">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-secondary);">
              ${isTampered
                ? 'Tampering detected by cryptographic engine; exact structural localization is unavailable for this format.'
                : 'No specific affected structural locations to display.'}
            </div>
          </div>
        `;
      } else {
        itemsContainer.innerHTML = items.map((item, idx) => {
          const locType = item.location_type || 'UNKNOWN';
          const changeType = item.change_type || 'CONTENT_CHANGED';
          const itemConf = (item.localization_confidence || 'UNKNOWN').toUpperCase();
          const confBadgeClass = itemConf === 'HIGH' ? 'ok' : itemConf === 'MEDIUM' ? 'warn' : 'neutral';
          const hasBeforeAfter = (item.before_value !== null && item.before_value !== undefined) || (item.after_value !== null && item.after_value !== undefined);

          return `
            <div style="background: var(--bg-surface); border: 1px solid var(--border); border-left: 3px solid var(--danger); border-radius: 4px; padding: var(--space-4); margin-bottom: var(--space-3);">
              
              <!-- Location Header Row -->
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-3); border-bottom: 1px solid var(--border-subtle); padding-bottom: var(--space-2);">
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                  <span style="font-family: 'IBM Plex Mono', monospace; font-size: 0.6875rem; color: var(--text-muted);">#${idx + 1}</span>
                  <span style="font-family: 'Inter', sans-serif; font-size: var(--text-sm); font-weight: 600; color: var(--text-primary);">${item.location || 'Unknown Location'}</span>
                  <span class="badge badge--accent" style="font-size: 0.625rem;">${locType}</span>
                </div>
                <div style="display: flex; align-items: center; gap: 6px;">
                  <span class="badge badge--danger" style="font-size: 0.625rem;">${changeType}</span>
                  <span class="badge badge--${confBadgeClass}" style="font-size: 0.625rem;">${itemConf} CONFIDENCE</span>
                </div>
              </div>

              <!-- Structural Coordinates -->
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); margin-bottom: var(--space-3); background: var(--bg-raised); border: 1px solid var(--border-subtle); border-radius: 4px; padding: var(--space-2) var(--space-3);">
                ${item.page != null ? `<div><span style="color:var(--text-muted)">Page:</span> <span style="color:var(--text-primary);font-weight:600">${item.page}</span></div>` : ''}
                ${item.object_id != null ? `<div><span style="color:var(--text-muted)">Object ID:</span> <span style="color:var(--text-primary);font-weight:600">${item.object_id}</span></div>` : ''}
                ${item.json_path ? `<div><span style="color:var(--text-muted)">JSON Path:</span> <span style="color:var(--text-primary);font-weight:600">${item.json_path}</span></div>` : ''}
                ${item.xml_xpath ? `<div><span style="color:var(--text-muted)">XPath:</span> <span style="color:var(--text-primary);font-weight:600">${item.xml_xpath}</span></div>` : ''}
                ${item.document_part ? `<div><span style="color:var(--text-muted)">Part:</span> <span style="color:var(--text-primary);font-weight:600">${item.document_part}</span></div>` : ''}
                ${item.structural_path ? `<div><span style="color:var(--text-muted)">Structural Path:</span> <span style="color:var(--text-primary)">${item.structural_path}</span></div>` : ''}
                ${item.byte_range ? `<div><span style="color:var(--text-muted)">Byte Range:</span> <span style="color:var(--text-primary)">[${item.byte_range.join(', ')}]</span></div>` : ''}
              </div>

              <!-- Before / After Diff (If Available) -->
              ${hasBeforeAfter ? `
                <div style="display: grid; grid-template-columns: 1fr 1fr; gap: var(--space-3); margin-bottom: var(--space-3);">
                  <div style="background: rgba(239, 68, 68, 0.05); border: 1px solid rgba(239, 68, 68, 0.2); border-radius: 4px; padding: var(--space-3);">
                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: 0.6875rem; font-weight: 600; color: var(--danger); margin-bottom: 4px;">BEFORE (TRUSTED BASELINE)</div>
                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-primary); word-break: break-all;">
                      ${item.before_value !== null && item.before_value !== undefined ? (typeof item.before_value === 'object' ? JSON.stringify(item.before_value) : String(item.before_value)) : '— (Not present)'}
                    </div>
                  </div>
                  <div style="background: rgba(59, 130, 246, 0.05); border: 1px solid rgba(59, 130, 246, 0.2); border-radius: 4px; padding: var(--space-3);">
                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: 0.6875rem; font-weight: 600; color: var(--accent); margin-bottom: 4px;">AFTER (CURRENT DOCUMENT)</div>
                    <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-primary); word-break: break-all;">
                      ${item.after_value !== null && item.after_value !== undefined ? (typeof item.after_value === 'object' ? JSON.stringify(item.after_value) : String(item.after_value)) : '— (Deleted)'}
                    </div>
                  </div>
                </div>
              ` : ''}

              <!-- Evidence Points List -->
              ${item.evidence && item.evidence.length > 0 ? `
                <div style="margin-top: 6px;">
                  <div style="font-family: 'IBM Plex Mono', monospace; font-size: 0.6875rem; font-weight: 600; color: var(--text-secondary); margin-bottom: 4px;">EVIDENCE POINTS</div>
                  <ul style="list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 4px;">
                    ${item.evidence.map(e => `
                      <li style="display: flex; align-items: flex-start; gap: 6px; font-size: var(--text-xs); color: var(--text-secondary); line-height: 1.4;">
                        <span style="color: var(--danger); line-height: 1;">•</span>
                        <span>${e}</span>
                      </li>
                    `).join('')}
                  </ul>
                </div>
              ` : ''}

            </div>
          `;
        }).join('');
      }
    }

    // Limitations Box
    const limBox = document.getElementById('loc-limitations-box');
    const limList = document.getElementById('loc-limitations-list');
    if (limBox && limList) {
      if (limitations.length > 0) {
        limBox.style.display = 'block';
        limList.innerHTML = limitations.map(lim => `
          <div style="display: flex; align-items: flex-start; gap: 6px; font-size: var(--text-xs); color: var(--text-muted); font-family: 'IBM Plex Mono', monospace;">
            <span style="color: var(--text-muted);">ℹ</span>
            <span>${lim}</span>
          </div>
        `).join('');
      } else {
        limBox.style.display = 'none';
      }
    }
  }

  function renderSignatureTimeline(r) {

    const tl = r.signature_timeline ?? {};
    const events = (tl.events && tl.events.length > 0) ? tl.events : (tl.signatures ?? []);
    const findings = tl.findings ?? [];
    const totalFields = tl.total_signature_fields ?? (r.signature?.count ?? 0);
    const totalSigned = tl.signature_count ?? tl.total_signed_signatures ?? (events.length || (r.signature?.present ? 1 : 0));
    const revCount = tl.total_revisions ?? tl.revision_count ?? 1;
    const tlStatus = (tl.status ?? tl.timeline_status ?? (r.signature?.present ? 'AVAILABLE' : 'NO_SIGNATURES')).toUpperCase();
    const consistency = (tl.consistency_status ?? 'UNKNOWN').toUpperCase();
    const orderConf = (tl.chronology_confidence ?? tl.timeline_order_confidence ?? 'HIGH').toUpperCase();
    const docFormat = tl.format ?? (r.document?.pdf_version ? 'PDF' : 'DOCUMENT');

    // Badges
    const consClass = consistency === 'CONSISTENT' ? 'ok' : consistency === 'INCONSISTENT' ? 'danger' : 'warn';
    const consBadge = document.getElementById('tl-consistency-badge');
    if (consBadge) {
      consBadge.className = `badge badge--${consClass}`;
      consBadge.textContent = `CONSISTENCY: ${consistency}`;
    }

    const confClass = orderConf === 'HIGH' ? 'ok' : orderConf === 'MEDIUM' ? 'warn' : 'neutral';
    const confBadge = document.getElementById('tl-order-confidence-badge');
    if (confBadge) {
      confBadge.className = `badge badge--${confClass}`;
      confBadge.textContent = `ORDER CONFIDENCE: ${orderConf}`;
    }

    const statsBadge = document.getElementById('tl-stats-badge');
    if (statsBadge) {
      if (tlStatus === 'NOT_AVAILABLE') {
        statsBadge.textContent = `FORMAT: ${docFormat}`;
        statsBadge.className = 'badge badge--neutral';
      } else {
        statsBadge.textContent = `${totalSigned} OF ${totalFields || totalSigned} SIGNED`;
      }
    }

    // Metric cards
    const fieldsCountEl = document.getElementById('tl-fields-count');
    if (fieldsCountEl) fieldsCountEl.textContent = tlStatus === 'NOT_AVAILABLE' ? 'N/A' : `${totalFields || totalSigned} Field${(totalFields || totalSigned) === 1 ? '' : 's'}`;

    const signedCountEl = document.getElementById('tl-signed-count');
    if (signedCountEl) signedCountEl.textContent = tlStatus === 'NOT_AVAILABLE' ? '0' : `${totalSigned} Signature${totalSigned === 1 ? '' : 's'}`;

    const revCountEl = document.getElementById('tl-revisions-count');
    if (revCountEl) revCountEl.textContent = tlStatus === 'NOT_AVAILABLE' ? 'N/A' : `${revCount} Revision${revCount === 1 ? '' : 's'}`;

    const statusValEl = document.getElementById('tl-status-val');
    if (statusValEl) {
      if (tlStatus === 'NOT_AVAILABLE') {
        statusValEl.textContent = 'NOT AVAILABLE';
        statusValEl.style.color = 'var(--text-muted)';
      } else {
        statusValEl.textContent = consistency;
        statusValEl.style.color = consistency === 'CONSISTENT' ? 'var(--ok)' : consistency === 'INCONSISTENT' ? 'var(--danger)' : 'var(--warn)';
      }
    }

    // Tree container
    const treeContainer = document.getElementById('timeline-tree-container');
    if (treeContainer) {
      if (tlStatus === 'NOT_AVAILABLE') {
        treeContainer.innerHTML = `
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-left: 3px solid var(--neutral); border-radius: 4px; padding: var(--space-4);">
            <div style="display: flex; align-items: center; justify-content: space-between; margin-bottom: 6px;">
              <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-sm); font-weight: 600; color: var(--text-primary);">
                TIMELINE ANALYSIS NOT AVAILABLE
              </span>
              <span class="badge badge--neutral" style="font-size: 0.6875rem;">Format: ${docFormat}</span>
            </div>
            <p style="font-family: 'Inter', sans-serif; font-size: var(--text-xs); color: var(--text-secondary); margin: 0; line-height: 1.5;">
              ${tl.reason || 'Reliable signature chronology is not available for this file format.'}
            </p>
          </div>
        `;
      } else if (events.length === 0) {
        if (r.signature?.present === false || tlStatus === 'NO_SIGNATURES') {
          treeContainer.innerHTML = `
            <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4); text-align: center; color: var(--text-muted); font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs);">
              No digital signatures detected in this document.
            </div>
          `;
        } else {
          treeContainer.innerHTML = `
            <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4); color: var(--text-secondary); font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs);">
              Single signature detected in primary verification stream (Revision 1 of ${revCount}).
            </div>
          `;
        }
      } else {
        let html = '<div style="display: flex; flex-direction: column; gap: 0;">';

        events.forEach((sig, index) => {
          const seq = sig.sequence ?? sig.sequence_number ?? (index + 1);
          const sigId = sig.signature_id || `sig-${seq}`;
          const status = (sig.cryptographic_status ?? sig.status ?? 'NOT_CHECKED').toUpperCase();
          const statusBadgeClass = status === 'VALID' ? 'ok' : status === 'INVALID' ? 'danger' : 'warn';
          const signerName = sig.signer_name || sig.signer?.common_name || 'Signer Identity Unspecified';
          const signerOrg = sig.signer?.organization || sig.signer_certificate_subject || 'Organization Unspecified';
          const rawTime = sig.signing_time || (typeof sig.signing_time_info === 'object' ? sig.signing_time_info?.value : null);
          const timeSource = sig.signing_time_source || (typeof sig.signing_time_info === 'object' ? sig.signing_time_info?.source : null) || 'UNKNOWN';
          const formattedTime = rawTime ? new Date(rawTime).toUTCString().replace('GMT', 'UTC') : 'No timestamp recorded';
          const rev = sig.revision?.covers_revision ?? (sig.version_id || sig.revision?.revision_number || seq);
          const totalRevs = sig.revision?.total_revisions ?? revCount;
          const isLatest = sig.revision?.is_latest_revision === true || seq === events.length;
          const brRanges = sig.byte_range?.ranges ? `[${sig.byte_range.ranges.join(', ')}]` : (sig.covered_content || 'N/A');
          const brLen = sig.byte_range?.covered_length ? formatBytes(sig.byte_range.covered_length) : (sig.covered_content || '—');
          const postChange = sig.post_signature_change ?? 'NONE';
          const sigAlgo = sig.signature_algorithm || 'RSA';
          const digestAlgo = sig.digest_algorithm || 'SHA-256';
          const certFp = sig.certificate_fingerprint || 'Not Available';
          const coverageStatus = sig.coverage_status || sig.byte_range?.coverage_status || 'VALID';
          const certStatus = sig.certificate_status || (status === 'VALID' ? 'VALID' : 'UNKNOWN');
          const drawerId = `sig-detail-drawer-${seq}`;

          html += `
            <!-- Signature Node ${seq} -->
            <div style="background: var(--bg-raised); border: 1px solid var(--border); border-left: 3px solid ${status === 'VALID' ? 'var(--ok)' : status === 'INVALID' ? 'var(--danger)' : 'var(--warn)'}; border-radius: 4px; padding: var(--space-4); margin-bottom: var(--space-2); transition: background 0.15s ease;">
              <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-3); border-bottom: 1px solid var(--border-subtle); padding-bottom: var(--space-2);">
                <div style="display: flex; align-items: center; gap: 8px; flex-wrap: wrap;">
                  <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-sm); font-weight: 600; color: var(--text-primary);">
                    ● SIGNATURE #${seq}
                  </span>
                  <span class="badge badge--neutral" style="font-size: 0.6875rem;">Field: ${sig.field_name || sigId}</span>
                  <span class="badge badge--neutral" style="font-size: 0.6875rem;">Revision ${rev} of ${totalRevs}</span>
                  ${isLatest ? '<span class="badge badge--accent" style="font-size: 0.6875rem;">Latest Revision</span>' : ''}
                </div>
                <div style="display: flex; align-items: center; gap: 8px;">
                  <span class="badge badge--${statusBadgeClass}" style="font-size: 0.75rem;">
                    ${status === 'VALID' ? '✅ VALID' : status === 'INVALID' ? '✕ INVALID' : '⚠ ' + status}
                  </span>
                  <button type="button" class="btn btn-secondary btn-sm" onclick="toggleSigDrawer('${drawerId}')" style="padding: 2px 8px; font-size: 0.6875rem; font-family: 'IBM Plex Mono', monospace; cursor: pointer;">
                    Details ▾
                  </button>
                </div>
              </div>

              <!-- Signature Metadata Summary Grid -->
              <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(200px, 1fr)); gap: var(--space-3); font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs);">
                <div>
                  <div style="color: var(--text-secondary); font-size: 0.6875rem;">SIGNER &amp; AUTHORITY</div>
                  <div style="color: var(--text-primary); font-weight: 600; margin-top: 2px;">${signerName}</div>
                  <div style="color: var(--text-muted); font-size: 0.6875rem;">${signerOrg}</div>
                </div>

                <div>
                  <div style="color: var(--text-secondary); font-size: 0.6875rem;">TIMESTAMP &amp; SOURCE</div>
                  <div style="color: var(--text-primary); margin-top: 2px;">${formattedTime}</div>
                  <div style="color: var(--text-muted); font-size: 0.6875rem;">Source: ${timeSource}</div>
                </div>

                <div>
                  <div style="color: var(--text-secondary); font-size: 0.6875rem;">ALGORITHMS</div>
                  <div style="color: var(--text-primary); margin-top: 2px;">${digestAlgo} / ${sigAlgo}</div>
                  <div style="color: var(--text-muted); font-size: 0.6875rem;">Cert: ${certFp.length > 20 ? certFp.slice(0, 16) + '…' : certFp}</div>
                </div>

                <div>
                  <div style="color: var(--text-secondary); font-size: 0.6875rem;">BYTERANGE &amp; COVERAGE</div>
                  <div style="color: var(--text-primary); margin-top: 2px;">${brRanges}</div>
                  <div style="color: var(--text-muted); font-size: 0.6875rem;">Covered: ${brLen} (${coverageStatus})</div>
                </div>
              </div>

              <!-- Expandable Full Signature Details Drawer -->
              <div id="${drawerId}" style="display: none; margin-top: var(--space-3); padding-top: var(--space-3); border-top: 1px dashed var(--border); background: var(--bg-surface); padding: var(--space-3); border-radius: 4px;">
                <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: 8px; letter-spacing: 0.05em;">
                  DETAILED AUDIT RECORD — SIGNATURE #${seq}
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(220px, 1fr)); gap: 10px; font-family: 'IBM Plex Mono', monospace; font-size: 0.6875rem;">
                  <div><span style="color: var(--text-secondary);">Signature ID:</span> <span style="color: var(--text-primary);">${sigId}</span></div>
                  <div><span style="color: var(--text-secondary);">Signer:</span> <span style="color: var(--text-primary);">${signerName}</span></div>
                  <div><span style="color: var(--text-secondary);">Signing Time:</span> <span style="color: var(--text-primary);">${formattedTime}</span></div>
                  <div><span style="color: var(--text-secondary);">Time Source:</span> <span style="color: var(--text-primary);">${timeSource}</span></div>
                  <div><span style="color: var(--text-secondary);">Revision:</span> <span style="color: var(--text-primary);">Revision ${rev}</span></div>
                  <div><span style="color: var(--text-secondary);">Digest Algorithm:</span> <span style="color: var(--text-primary);">${digestAlgo}</span></div>
                  <div><span style="color: var(--text-secondary);">Signature Algorithm:</span> <span style="color: var(--text-primary);">${sigAlgo}</span></div>
                  <div><span style="color: var(--text-secondary);">Certificate Status:</span> <span style="color: var(--text-primary);">${certStatus}</span></div>
                  <div style="grid-column: 1 / -1;"><span style="color: var(--text-secondary);">Certificate Fingerprint (SHA-256):</span> <span style="color: var(--text-code); word-break: break-all;">${certFp}</span></div>
                  <div><span style="color: var(--text-secondary);">Coverage Status:</span> <span style="color: var(--text-primary);">${coverageStatus}</span></div>
                  <div><span style="color: var(--text-secondary);">Cryptographic Verification:</span> <span style="color: ${status === 'VALID' ? 'var(--ok)' : 'var(--danger)'};">${status}</span></div>
                  <div><span style="color: var(--text-secondary);">Chronology Confidence:</span> <span style="color: var(--text-primary);">${orderConf}</span></div>
                </div>
              </div>

              <!-- Post-Signature Status Callout -->
              <div style="margin-top: var(--space-3); padding-top: var(--space-2); border-top: 1px solid var(--border-subtle); display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: 0.6875rem; color: ${postChange === 'LEGITIMATE_INCREMENTAL_UPDATE' ? 'var(--ok)' : postChange === 'UNAUTHORIZED_SIGNED_CONTENT_CHANGE' ? 'var(--danger)' : 'var(--text-secondary)'};">
                  ${postChange === 'LEGITIMATE_INCREMENTAL_UPDATE'
                    ? '✓ Legitimate Incremental Update: Subsequent revisions appended safely without modifying this signed byte range.'
                    : postChange === 'UNAUTHORIZED_SIGNED_CONTENT_CHANGE'
                    ? '✕ Unauthorized Modification: Content within this signed revision was altered or corrupted.'
                    : '🔵 Signature covers the latest revision of the document.'}
                </span>
                <span class="badge badge--neutral" style="font-size: 0.625rem;">Coverage: ${coverageStatus}</span>
              </div>
            </div>
          `;

          // If not the last signature, show connector
          if (index < events.length - 1) {
            html += `
              <div style="display: flex; flex-direction: column; align-items: center; margin: 4px 0 8px 0;">
                <div style="width: 2px; height: 14px; background: var(--border);"></div>
                <div style="display: flex; align-items: center; gap: 6px; background: var(--bg-surface); border: 1px solid var(--border); border-radius: 12px; padding: 2px 10px; font-family: 'IBM Plex Mono', monospace; font-size: 0.625rem; color: var(--text-secondary);">
                  <span>↓</span>
                  <span>Incremental Update (Appends Revision ${index + 2})</span>
                </div>
                <div style="width: 2px; height: 14px; background: var(--border);"></div>
              </div>
            `;
          }
        });

        // Terminal Node: Current Document State
        html += `
          <div style="display: flex; flex-direction: column; align-items: center; margin: 4px 0 8px 0;">
            <div style="width: 2px; height: 14px; background: var(--border);"></div>
          </div>
          <div style="background: var(--bg-surface); border: 1px dashed var(--border); border-radius: 4px; padding: var(--space-3); display: flex; align-items: center; justify-content: space-between; font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-secondary);">
            <div style="display: flex; align-items: center; gap: 8px;">
              <span style="color: var(--accent);">●</span>
              <span style="color: var(--text-primary); font-weight: 600;">CURRENT DOCUMENT ROOT (Revision ${revCount})</span>
            </div>
            <span class="badge badge--neutral" style="font-size: 0.625rem;">Total Size: ${formatBytes(r.document?.file_size || 0)}</span>
          </div>
        `;

        html += '</div>';
        treeContainer.innerHTML = html;
      }
    }

    // Findings List
    const findingsList = document.getElementById('timeline-findings-list');
    if (findingsList) {
      if (!findings || findings.length === 0) {
        findingsList.innerHTML = `
          <div style="display: flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--ok); padding: 8px 0;">
            <span>✓</span>
            <span>Timeline structure and revision sequence are consistent without anomalies.</span>
          </div>
        `;
      } else {
        findingsList.innerHTML = findings.map((f) => {
          const sev = (f.severity || 'INFO').toUpperCase();
          const sevBadge = sev === 'CRITICAL' || sev === 'HIGH' ? 'danger' : sev === 'MEDIUM' ? 'warn' : 'neutral';
          return `
            <div style="padding: 6px 8px; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 4px;">
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-primary);">${f.title}</span>
                <span class="badge badge--${sevBadge}" style="font-size: 0.625rem;">${sev}</span>
              </div>
              <div style="font-size: 0.6875rem; color: var(--text-secondary); line-height: 1.4;">${f.description}</div>
            </div>
          `;
        }).join('');
      }
    }
  }

  // Global helper to toggle drawer
  (window as any).toggleSigDrawer = function(id: string) {
    const el = document.getElementById(id);
    if (el) {
      el.style.display = (el.style.display === 'none' || !el.style.display) ? 'block' : 'none';
    }
  };

  function renderCertificateInspector(r) {
    const insp = r.certificate_inspection ?? {};
    const cert = insp.certificate ?? {};
    const pk = insp.public_key ?? {};
    const val = insp.validity ?? {};
    const trust = insp.trust ?? {};
    const fp = insp.fingerprint ?? {};
    const sec = insp.security_assessment ?? {};
    const chain = insp.chain ?? [];
    const exts = insp.extensions ?? [];
    const findings = insp.findings ?? [];

    const valStatus = (val.status ?? 'UNKNOWN').toUpperCase();
    const valClass = valStatus === 'VALID' ? 'ok' : valStatus === 'EXPIRED' ? 'danger' : valStatus === 'NOT_YET_VALID' ? 'warn' : 'neutral';
    const statusBadge = document.getElementById('cert-status-badge');
    if (statusBadge) {
      statusBadge.className = `badge badge--${valClass}`;
      statusBadge.textContent = `STATUS: ${valStatus}`;
    }

    const trustStatus = (trust.status ?? 'UNKNOWN').toUpperCase();
    const trustClass = trustStatus === 'TRUSTED' ? 'ok' : trustStatus === 'SELF_SIGNED' ? 'warn' : trustStatus === 'UNTRUSTED' ? 'danger' : 'neutral';
    const trustBadge = document.getElementById('cert-trust-badge');
    if (trustBadge) {
      trustBadge.className = `badge badge--${trustClass}`;
      trustBadge.textContent = `TRUST: ${trustStatus}`;
    }

    const keyStrength = (sec.key_strength ?? 'UNKNOWN').toUpperCase();
    const keyClass = keyStrength === 'ACCEPTABLE' ? 'ok' : keyStrength === 'WEAK' ? 'danger' : 'neutral';
    const keyBadge = document.getElementById('key-strength-badge');
    if (keyBadge) {
      keyBadge.className = `badge badge--${keyClass}`;
      keyBadge.textContent = `KEY: ${keyStrength}`;
    }

    // Identity KV
    const idKv = document.getElementById('cert-identity-kv');
    if (idKv) {
      const subj = cert.subject ?? {};
      const issu = cert.issuer ?? {};
      idKv.innerHTML = kvRows([
        ['Subject CN', typeof subj === 'object' ? (subj.common_name || 'Not available') : (subj || 'Not available')],
        ['Organization', typeof subj === 'object' ? (subj.organization || 'None / Unspecified') : 'None'],
        ['Org Unit', typeof subj === 'object' ? (subj.organizational_unit || 'None') : 'None'],
        ['Country / State', `${typeof subj === 'object' ? (subj.country || '—') : '—'} / ${typeof subj === 'object' ? (subj.state || '—') : '—'}`],
        ['Issuer CN', typeof issu === 'object' ? (issu.common_name || 'Not available') : (issu || 'Not available')],
        ['Issuer Org', typeof issu === 'object' ? (issu.organization || 'None / Unspecified') : 'None'],
        ['Serial Number', cert.serial_number || 'Not available', true],
        ['Self-Signed', cert.is_self_signed === true ? 'Yes' : cert.is_self_signed === false ? 'No' : 'Unknown'],
      ]);
    }

    // Crypto KV
    const cryptoKv = document.getElementById('cert-crypto-kv');
    if (cryptoKv) {
      cryptoKv.innerHTML = kvRows([
        ['Key Algorithm', pk.algorithm || 'Not available', true],
        ['Key Size / Curve', pk.curve ? `${pk.curve} (${pk.key_size || '?'} bits)` : pk.key_size ? `${pk.key_size} bits` : 'Not available', true],
        ['Public Exponent', pk.exponent ? `${pk.exponent} (0x${pk.exponent.toString(16).toUpperCase()})` : 'N/A', true],
        ['Cert Signature', cert.signature_algorithm || 'Not available', true],
        ['Doc Signature', r.signature?.signature_algorithm || 'Not available', true],
        ['Digest Algorithm', r.signature?.digest_algorithm || 'Not available', true],
        ['Validity Start', val.not_before || 'Not available'],
        ['Validity End', val.not_after || 'Not available'],
      ]);
    }

    // Extensions & Fingerprint KV
    const extKv = document.getElementById('cert-extensions-kv');
    if (extKv) {
      const ku = exts.find(e => e.name?.toLowerCase().includes('keyusage') && !e.name?.toLowerCase().includes('extended'));
      const eku = exts.find(e => e.name?.toLowerCase().includes('extendedkeyusage'));
      const san = exts.find(e => e.name?.toLowerCase().includes('altname') || e.name?.toLowerCase().includes('alternativename'));
      const bc = exts.find(e => e.name?.toLowerCase().includes('basicconstraints'));

      extKv.innerHTML = kvRows([
        ['SHA-256 Fingerprint', fp.value || 'Not available', true],
        ['Key Usage', ku?.value || 'Not specified'],
        ['Extended Key Usage', eku?.value || 'None'],
        ['Basic Constraints', bc?.value || 'None'],
        ['Subject Alt Name', san?.value || 'None'],
        ['Extensions Total', exts.length ? String(exts.length) : 'None'],
      ]);
    }

    // Certificate Chain Trace
    const chainList = document.getElementById('cert-chain-list');
    if (chainList) {
      if (!chain || chain.length === 0) {
        chainList.innerHTML = `<div style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);color:var(--text-muted);">No certificate chain available.</div>`;
      } else {
        chainList.innerHTML = chain.map((node, idx) => {
          const role = (node.role || 'SIGNER').toUpperCase();
          const roleBadge = role === 'SIGNER' ? 'accent' : role === 'ROOT_CA' ? 'ok' : 'warn';
          return `
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); padding: 6px 0; border-bottom: 1px solid var(--border-subtle);">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--text-muted); font-size: 0.75rem;">${idx === 0 ? '↳' : '↓'}</span>
                <div>
                  <span style="color: var(--text-primary); font-weight: 600;">${node.subject || 'Unknown Cert'}</span>
                  ${node.serial_number ? `<div style="color: var(--text-muted); font-size: 0.6875rem;">SN: ${node.serial_number}</div>` : ''}
                </div>
              </div>
              <span class="badge badge--${roleBadge}" style="font-size: 0.625rem;">
                ${role}
              </span>
            </div>
          `;
        }).join('');
      }
    }

    // Security Findings List
    const findingsList = document.getElementById('cert-findings-list');
    if (findingsList) {
      if (!findings || findings.length === 0) {
        findingsList.innerHTML = `
          <div style="display: flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--ok); padding: 8px 0;">
            <span>✓</span>
            <span>No certificate security policy violations detected.</span>
          </div>
        `;
      } else {
        findingsList.innerHTML = findings.map(f => {
          const sev = (f.severity || 'INFO').toUpperCase();
          const sevBadge = sev === 'HIGH' ? 'danger' : sev === 'MEDIUM' ? 'warn' : 'neutral';
          return `
            <div style="padding: 6px 8px; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 4px;">
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-primary);">${f.title}</span>
                <span class="badge badge--${sevBadge}" style="font-size: 0.625rem;">${sev}</span>
              </div>
              <div style="font-size: 0.6875rem; color: var(--text-secondary); line-height: 1.4;">${f.description}</div>
            </div>
          `;
        }).join('');
      }
    }
  }

  function kvRows(pairs) {
    return pairs.map(([k, v, isMono]) =>
      `<dt class="kv-key">${k}</dt><dd class="kv-value${isMono ? ' mono' : ''}">${v}</dd>`
    ).join('');
  }

  function formatBytes(bytes) {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }

  load();
</script>

