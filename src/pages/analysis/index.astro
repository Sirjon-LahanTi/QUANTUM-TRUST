---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
---

<Layout title="Analysis History" description="Complete history of all PDF signature verifications performed by QuantumTrust.">
  <Navigation slot="sidebar" />

  <div class="page-header" style="display:flex;align-items:flex-start;justify-content:space-between;flex-wrap:wrap;gap:16px;">
    <div>
      <h1 class="page-title">Analysis History</h1>
      <p class="page-subtitle">All PDF signature verification analyses performed by QuantumTrust.</p>
    </div>
    <div style="display:flex;gap:10px;align-items:center;">
      <button id="clear-all-btn" class="btn btn-danger btn-sm" style="display:none;align-items:center;gap:6px;cursor:pointer;">
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M3 6h18"/><path d="M19 6v14c0 1-1 2-2 2H7c-1 0-2-1-2-2V6"/><path d="M8 6V4c0-1 1-2 2-2h4c1 0 2 1 2 2v2"/><line x1="10" y1="11" x2="10" y2="17"/><line x1="14" y1="11" x2="14" y2="17"/></svg>
        <span>Clear All History</span>
      </button>
    </div>
  </div>

  <div id="status-banner" style="display:none;margin-bottom:16px;padding:10px 14px;border-radius:4px;font-size:var(--text-xs);font-family:var(--font-mono);"></div>

  <section class="section" aria-label="Analysis history">
    <div class="table-wrapper" id="history-container">
      <div class="empty-state" id="history-loading">
        <span class="empty-state-icon" aria-hidden="true">⋯</span>
        <p class="empty-state-title">Loading history…</p>
      </div>
    </div>
  </section>
</Layout>

<script>
  const API = 'http://localhost:8000';

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }

  function verdictClass(v: string | null): string {
    if (!v) return 'badge--neutral';
    if (v.toUpperCase() === 'AUTHENTIC') return 'badge--ok';
    if (v.toUpperCase() === 'TAMPERED')  return 'badge--danger';
    if (v.toUpperCase() === 'SUSPICIOUS') return 'badge--warn';
    return 'badge--neutral';
  }

  function threatClass(l: string | null): string {
    if (!l) return 'badge--neutral';
    if (l === 'LOW')      return 'badge--ok';
    if (l === 'MEDIUM')   return 'badge--warn';
    if (l === 'HIGH')     return 'badge--warn';
    if (l === 'CRITICAL') return 'badge--danger';
    return 'badge--neutral';
  }

  function showBanner(msg: string, isError = false) {
    const banner = document.getElementById('status-banner');
    if (!banner) return;
    banner.style.display = 'block';
    banner.style.background = isError ? 'rgba(239, 68, 68, 0.15)' : 'rgba(34, 197, 94, 0.15)';
    banner.style.border = isError ? '1px solid #ef4444' : '1px solid #22c55e';
    banner.style.color = isError ? '#ef4444' : '#22c55e';
    banner.textContent = msg;
    setTimeout(() => {
      banner.style.display = 'none';
    }, 4000);
  }

  function renderEmptyState() {
    const container = document.getElementById('history-container');
    const clearBtn = document.getElementById('clear-all-btn');
    if (clearBtn) clearBtn.style.display = 'none';
    if (container) {
      container.innerHTML = `
        <div class="empty-state">
          <span class="empty-state-icon">📄</span>
          <p class="empty-state-title">No analyses yet</p>
          <p class="empty-state-desc">Upload a signed PDF from the Verify page to get started.</p>
        </div>`;
    }
  }

  async function deleteSingle(analysisId: string, filename: string) {
    const confirmed = window.confirm(`Are you sure you want to delete the analysis for "${filename}"?`);
    if (!confirmed) return;

    try {
      const res = await fetch(`${API}/api/analysis/${analysisId}`, {
        method: 'DELETE',
      });
      if (!res.ok) throw new Error(`Failed to delete (HTTP ${res.status})`);

      const row = document.getElementById(`row-${analysisId}`);
      if (row) {
        row.style.opacity = '0';
        row.style.transition = 'opacity 0.25s ease';
        setTimeout(() => {
          row.remove();
          const tbody = document.querySelector('.data-table tbody');
          if (!tbody || tbody.children.length === 0) {
            renderEmptyState();
          }
        }, 250);
      }
      showBanner(`Analysis "${filename}" deleted successfully.`);
    } catch (err: any) {
      showBanner(err.message || 'Error deleting analysis', true);
    }
  }

  async function clearAll() {
    const confirmed = window.confirm('Are you sure you want to delete ALL analysis history? This action cannot be undone.');
    if (!confirmed) return;

    try {
      const res = await fetch(`${API}/api/analyses`, {
        method: 'DELETE',
      });
      if (!res.ok) throw new Error(`Failed to clear history (HTTP ${res.status})`);

      renderEmptyState();
      showBanner('All analysis history deleted successfully.');
    } catch (err: any) {
      showBanner(err.message || 'Error clearing history', true);
    }
  }

  async function load() {
    const container = document.getElementById('history-container')!;
    const clearBtn = document.getElementById('clear-all-btn');

    try {
      const res = await fetch(`${API}/api/analyses?limit=200`);
      if (!res.ok) throw new Error(`Server error: ${res.status}`);
      const data = await res.json();

      if (!Array.isArray(data) || data.length === 0) {
        renderEmptyState();
        return;
      }

      if (clearBtn) {
        clearBtn.style.display = 'inline-flex';
        clearBtn.onclick = clearAll;
      }

      const rows = data.map((a: any) => {
        const date = new Date(a.created_at).toLocaleString();
        const verdict = a.verdict ?? '—';
        const threat  = a.security?.threat_level ?? '—';
        const fname = a.document?.filename || 'Document';
        return `
          <tr id="row-${a.analysis_id}">
            <td class="mono-cell" style="font-size:var(--text-xs);color:var(--text-muted);">${a.analysis_id}</td>
            <td><a href="/analysis/${a.analysis_id}" rel="noopener noreferrer" style="color:var(--text-accent)">${fname}</a></td>
            <td class="mono-cell">${formatBytes(a.document?.file_size || 0)}</td>
            <td><span class="badge ${verdictClass(verdict)}">${verdict}</span></td>
            <td><span class="badge ${threatClass(threat)}">${threat}</span></td>
            <td class="num-cell mono-cell">${a.security?.threat_score ?? '—'}</td>
            <td style="font-size:var(--text-xs);color:var(--text-muted)">${date}</td>
            <td>
              <div style="display:flex;align-items:center;gap:6px;">
                <a href="/analysis/${a.analysis_id}" rel="noopener noreferrer" class="btn btn-secondary btn-sm">View</a>
                <button class="btn btn-danger btn-sm del-btn" data-id="${a.analysis_id}" data-file="${fname.replace(/"/g, '&quot;')}" style="cursor:pointer;" title="Delete this analysis">
                  Delete
                </button>
              </div>
            </td>
          </tr>`;
      }).join('');

      container.innerHTML = `
        <table class="data-table">
          <thead>
            <tr>
              <th>Analysis ID</th>
              <th>Document</th>
              <th>Size</th>
              <th>Verdict</th>
              <th>Threat</th>
              <th>Score</th>
              <th>Analyzed</th>
              <th>Actions</th>
            </tr>
          </thead>
          <tbody>${rows}</tbody>
        </table>`;

      // Attach delete listeners
      container.querySelectorAll('.del-btn').forEach((btn: any) => {
        btn.addEventListener('click', () => {
          const id = btn.getAttribute('data-id');
          const file = btn.getAttribute('data-file');
          if (id) deleteSingle(id, file);
        });
      });
    } catch (err) {
      if (clearBtn) clearBtn.style.display = 'none';
      container.innerHTML = `
        <div class="error-banner" style="margin:16px;">
          Backend unavailable — start the QuantumTrust API server to load analysis history.
        </div>`;
    }
  }

  load();
</script>
