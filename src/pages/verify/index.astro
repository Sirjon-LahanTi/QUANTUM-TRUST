---
import Layout from '../../layouts/Layout.astro';
import Navigation from '../../components/Navigation.astro';
---

<Layout title="Verify Document" description="Upload a digitally signed document or file for cryptographic signature verification and integrity analysis.">
  <Navigation slot="sidebar" />

  <div class="page-header">
    <h1 class="page-title">Verify Document</h1>
    <p class="page-subtitle">Upload a digitally signed file or document to perform cryptographic signature verification, certificate analysis, and integrity checking.</p>
  </div>

  <!-- Upload Panel -->
  <section class="section" id="upload-section" aria-label="Upload signed file">
    <div class="upload-zone" id="upload-zone" role="button" tabindex="0" aria-label="Upload signed file">
      <input type="file" id="file-input" aria-label="Choose file to verify" />
      <div class="upload-icon" aria-hidden="true">
        <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M21 15v4a2 2 0 01-2 2H5a2 2 0 01-2-2v-4"/>
          <polyline points="17 8 12 3 7 8"/>
          <line x1="12" y1="3" x2="12" y2="15"/>
        </svg>
      </div>
      <div class="upload-label">Upload Signed File</div>
      <div class="upload-hint">Drop your digitally signed document or file here or browse to begin verification.</div>
      <div class="upload-hint" style="margin-top:8px;font-size:0.6875rem;">All file types supported &middot; Max 50MB &middot; Secure local analysis</div>
    </div>
    <div id="file-info" class="file-info" style="display:none"></div>
    <div id="upload-error" class="error-banner" style="display:none;margin-top:12px;"></div>
  </section>

  <!-- Progress Panel (hidden until upload) -->
  <section class="section" id="progress-section" style="display:none;" aria-label="Verification progress" aria-live="polite">
    <div class="card">
      <div class="card-title">Verifying document…</div>
      <div class="progress-steps" id="progress-steps">
        <div class="progress-step pending" data-step="upload">
          <span class="step-indicator"></span>Uploading document
        </div>
        <div class="progress-step pending" data-step="parse">
          <span class="step-indicator"></span>Parsing PDF structure
        </div>
        <div class="progress-step pending" data-step="signature">
          <span class="step-indicator"></span>Detecting digital signature
        </div>
        <div class="progress-step pending" data-step="algorithm">
          <span class="step-indicator"></span>Detecting cryptographic algorithms
        </div>
        <div class="progress-step pending" data-step="certificate">
          <span class="step-indicator"></span>Analyzing certificate
        </div>
        <div class="progress-step pending" data-step="verify">
          <span class="step-indicator"></span>Verifying signature
        </div>
        <div class="progress-step pending" data-step="integrity">
          <span class="step-indicator"></span>Checking document integrity
        </div>
        <div class="progress-step pending" data-step="duplicate">
          <span class="step-indicator"></span>Checking duplicate status
        </div>
        <div class="progress-step pending" data-step="verdict">
          <span class="step-indicator"></span>Generating verification verdict
        </div>
      </div>
    </div>
  </section>

  <!-- Results Panel (hidden until analysis complete) -->
  <section id="results-section" style="display:none;" aria-label="Verification results">

    <!-- Verdict -->
    <div id="verdict-container" class="section"></div>

    <!-- WHY THIS VERDICT? Explainable Verification Section -->
    <div class="section" id="explainable-section">
      <div class="card" style="border-left: 3px solid var(--accent); background: var(--bg-surface); padding: var(--space-5);">
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-3);">
          <div style="display: flex; align-items: center; gap: 10px;">
            <span class="section-title" style="margin: 0; font-size: 0.8125rem; letter-spacing: 0.05em; font-weight: 600; color: var(--text-primary);">
              WHY THIS VERDICT?
            </span>
            <span class="badge badge--neutral" id="exp-confidence-badge" style="font-size: 0.6875rem;">CONFIDENCE: —</span>
          </div>
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);">
            DETERMINISTIC VERIFICATION ENGINE
          </span>
        </div>

        <!-- Final Reason Callout -->
        <div id="exp-final-reason-box" style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4); margin-bottom: var(--space-4);">
          <div style="display: flex; align-items: flex-start; gap: 12px;">
            <span id="exp-verdict-icon" style="font-size: 1.25rem; line-height: 1;">•</span>
            <div>
              <div style="font-family: 'Inter', sans-serif; font-size: var(--text-base); color: var(--text-primary); font-weight: 500; line-height: 1.5;" id="exp-final-reason-text">
                Loading explanation…
              </div>
              <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-secondary); margin-top: 6px;" id="exp-summary-text">
              </div>
            </div>
          </div>
        </div>

        <!-- Two Column Trace & Evidence -->
        <div class="exp-grid" style="display: grid; grid-template-columns: 1.2fr 0.8fr; gap: var(--space-4); margin-bottom: var(--space-3);">
          <!-- Verification Trace -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              VERIFICATION TRACE
            </div>
            <div id="exp-trace-list" style="display: flex; flex-direction: column; gap: 8px;">
            </div>
          </div>

          <!-- Technical Evidence Summary -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              TECHNICAL EVIDENCE
            </div>
            <dl class="kv-list" id="exp-evidence-kv" style="margin: 0;"></dl>
          </div>
        </div>

        <!-- Methodology note -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--border-subtle); padding-top: var(--space-2); margin-top: var(--space-2);">
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);" id="exp-methodology-text">
            Deterministic rule-based explanation derived from cryptographic verification evidence.
          </span>
          <span class="badge badge--neutral" style="font-size: 0.625rem; font-family: 'IBM Plex Mono', monospace;">No AI / Pure Evidence</span>
        </div>
      </div>
    </div>


    <div class="results-grid">
      <!-- Left column -->
      <div class="results-col">

        <!-- Document Info -->
        <div class="section">
          <div class="section-title">Document</div>
          <div class="card">
            <dl class="kv-list" id="doc-info"></dl>
          </div>
        </div>

        <!-- Digital Signature -->
        <div class="section">
          <div class="section-title">Digital Signature</div>
          <div class="card" id="sig-card">
            <dl class="kv-list" id="sig-info"></dl>
          </div>
        </div>

        <!-- Integrity -->
        <div class="section">
          <div class="section-title">Document Integrity</div>
          <div class="card" id="integrity-card">
            <dl class="kv-list" id="integrity-info"></dl>
          </div>
        </div>

      </div>

      <!-- Right column -->
      <div class="results-col">

        <!-- Cryptography -->
        <div class="section">
          <div class="section-title">Cryptography</div>
          <div class="card">
            <dl class="kv-list" id="crypto-info"></dl>
          </div>
        </div>

        <!-- Certificate -->
        <div class="section">
          <div class="section-title">Certificate</div>
          <div class="card" id="cert-card">
            <dl class="kv-list" id="cert-info"></dl>
          </div>
        </div>

        <!-- Duplicate -->
        <div class="section">
          <div class="section-title">Duplicate Detection</div>
          <div class="card" id="dup-card">
            <dl class="kv-list" id="dup-info"></dl>
          </div>
        </div>

      </div>
    </div>

    <!-- Certificate & Public Key Inspector -->
    <div class="section" id="cert-inspector-section" style="margin-top: var(--space-6);">
      <div class="card" style="border-top: 3px solid var(--accent); background: var(--bg-surface); padding: var(--space-5);">
        
        <!-- Section Header -->
        <div style="display: flex; justify-content: space-between; align-items: center; flex-wrap: wrap; gap: 8px; margin-bottom: var(--space-4); border-bottom: 1px solid var(--border-subtle); padding-bottom: var(--space-3);">
          <div style="display: flex; align-items: center; gap: 10px; flex-wrap: wrap;">
            <span class="section-title" style="margin: 0; font-size: 0.875rem; letter-spacing: 0.05em; font-weight: 600; color: var(--text-primary);">
              CERTIFICATE &amp; PUBLIC KEY INSPECTOR
            </span>
            <span class="badge badge--neutral" id="cert-status-badge">STATUS: —</span>
            <span class="badge badge--neutral" id="cert-trust-badge">TRUST: —</span>
            <span class="badge badge--neutral" id="key-strength-badge">KEY: —</span>
          </div>
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);">
            X.509 PKI SPECIFICATION
          </span>
        </div>

        <!-- 3-Column Inspection Grid -->
        <div class="cert-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-4);">
          
          <!-- Column 1: Identity & Signer -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              SIGNER &amp; ISSUER IDENTITY
            </div>
            <dl class="kv-list" id="cert-identity-kv" style="margin: 0;"></dl>
          </div>

          <!-- Column 2: Public Key & Cryptography -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              PUBLIC KEY &amp; CRYPTOGRAPHY
            </div>
            <dl class="kv-list" id="cert-crypto-kv" style="margin: 0;"></dl>
          </div>

          <!-- Column 3: Fingerprint & Extensions -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              FINGERPRINT &amp; EXTENSIONS
            </div>
            <dl class="kv-list" id="cert-extensions-kv" style="margin: 0;"></dl>
          </div>

        </div>

        <!-- Certificate Chain & Security Findings -->
        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: var(--space-4); margin-bottom: var(--space-3);">
          <!-- Certificate Chain Trace -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              CERTIFICATE CHAIN TRACE
            </div>
            <div id="cert-chain-list" style="display: flex; flex-direction: column; gap: 8px;"></div>
          </div>

          <!-- Evidence-Based Security Findings -->
          <div style="background: var(--bg-raised); border: 1px solid var(--border); border-radius: 4px; padding: var(--space-4);">
            <div style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-secondary); margin-bottom: var(--space-3); letter-spacing: 0.04em;">
              CERTIFICATE SECURITY FINDINGS
            </div>
            <div id="cert-findings-list" style="display: flex; flex-direction: column; gap: 8px;"></div>
          </div>
        </div>

        <!-- Fingerprint Disclaimer Notice -->
        <div style="display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: 8px; border-top: 1px solid var(--border-subtle); padding-top: var(--space-2); margin-top: var(--space-2);">
          <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--text-muted);">
            Notice: Certificate fingerprint identifies this certificate; it is not the document authenticity proof.
          </span>
          <span class="badge badge--neutral" style="font-size: 0.625rem; font-family: 'IBM Plex Mono', monospace;">X.509 v3 Standard</span>
        </div>
      </div>
    </div>

    <!-- Action Buttons -->
    <div class="section" style="display:flex;gap:12px;flex-wrap:wrap;align-items:center;margin-top:var(--space-6);">
      <button class="btn btn-secondary" id="new-analysis-btn">Verify Another Document</button>
      <a id="security-link" href="#" class="btn btn-primary" style="display:none;">
        Open Security Analysis &rarr;
      </a>
    </div>

  </section>
</Layout>

<script>
  const API = (window as any).PUBLIC_API_URL || import.meta.env.PUBLIC_API_URL || 'http://localhost:8000';

  const fileInput   = document.getElementById('file-input') as HTMLInputElement;
  const uploadZone  = document.getElementById('upload-zone')!;
  const uploadErr   = document.getElementById('upload-error')!;
  const fileInfo    = document.getElementById('file-info')!;
  const progressSec = document.getElementById('progress-section')!;
  const uploadSec   = document.getElementById('upload-section')!;
  const resultsSec  = document.getElementById('results-section')!;
  const newAnalBtn  = document.getElementById('new-analysis-btn')!;

  // Drag & drop
  uploadZone.addEventListener('dragover', (e) => { e.preventDefault(); uploadZone.classList.add('drag-over'); });
  uploadZone.addEventListener('dragleave', () => uploadZone.classList.remove('drag-over'));
  uploadZone.addEventListener('drop', (e) => {
    e.preventDefault();
    uploadZone.classList.remove('drag-over');
    const file = e.dataTransfer?.files[0];
    if (file) handleFile(file);
  });
  uploadZone.addEventListener('click', () => fileInput.click());
  uploadZone.addEventListener('keydown', (e) => { if (e.key === 'Enter' || e.key === ' ') fileInput.click(); });
  fileInput.addEventListener('change', () => { if (fileInput.files?.[0]) handleFile(fileInput.files[0]); });

  newAnalBtn.addEventListener('click', resetUI);

  const STEPS = ['upload','parse','signature','algorithm','certificate','verify','integrity','duplicate','verdict'];

  function setStep(name: string, state: 'active' | 'done') {
    const el = document.querySelector(`[data-step="${name}"]`);
    if (!el) return;
    el.classList.remove('pending','active','done');
    el.classList.add(state);
    const ind = el.querySelector('.step-indicator')!;
    if (state === 'done') { ind.textContent = '✓'; }
    else { ind.textContent = ''; }
  }

  function completeAllSteps() {
    STEPS.forEach(s => setStep(s, 'done'));
  }

  async function handleFile(file: File) {
    // Validate
    if (!file.name.toLowerCase().endsWith('.pdf') && file.type !== 'application/pdf') {
      showError('Only PDF files are accepted. Please upload a valid PDF document.');
      return;
    }
    if (file.size > 50 * 1024 * 1024) {
      showError('File size exceeds the 50MB limit. Please upload a smaller document.');
      return;
    }

    clearError();
    uploadSec.style.display = 'none';
    progressSec.style.display = 'block';
    resultsSec.style.display = 'none';

    // Reset steps
    STEPS.forEach(s => {
      const el = document.querySelector(`[data-step="${s}"]`);
      if (el) {
        el.classList.remove('active','done');
        el.classList.add('pending');
        el.querySelector('.step-indicator')!.textContent = '';
      }
    });

    setStep('upload', 'active');

    const formData = new FormData();
    formData.append('file', file);

    try {
      setStep('upload', 'done');
      setStep('parse', 'active');

      const response = await fetch(`${API}/api/analyze`, {
        method: 'POST',
        body: formData,
      });

      if (!response.ok) {
        const errData = await response.json().catch(() => ({ detail: 'Unknown server error' }));
        throw new Error(errData.detail || `Server error: ${response.status}`);
      }

      // Parse response JSON first
      const result = await response.json();

      // Persist to localStorage for client-side history resilience
      try {
        const existingHistory = JSON.parse(localStorage.getItem('qt_analysis_history') || '[]');
        const summaryItem = {
          analysis_id: result.analysis_id,
          document: result.document,
          signature: result.signature,
          security: result.security,
          verdict: result.verdict,
          created_at: result.created_at || new Date().toISOString()
        };
        const filtered = existingHistory.filter((h: any) => h.analysis_id !== result.analysis_id);
        filtered.unshift(summaryItem);
        localStorage.setItem('qt_analysis_history', JSON.stringify(filtered.slice(0, 100)));
        localStorage.setItem('qt_analysis_' + result.analysis_id, JSON.stringify(result));
      } catch (e) {
        console.warn('LocalStorage save failed:', e);
      }

      // Animate remaining steps
      const stepDelay = [150, 200, 250, 300, 350, 250, 200];
      const midSteps = STEPS.slice(1, -1);
      for (let i = 0; i < midSteps.length; i++) {
        setStep(midSteps[i], 'done');
        if (i + 1 < midSteps.length) {
          setStep(midSteps[i + 1], 'active');
          await delay(stepDelay[i] ?? 200);
        }
      }

      setStep('verdict', 'active');
      await delay(200);
      completeAllSteps();
      await delay(250);

      progressSec.style.display = 'none';
      renderResults(result);
      resultsSec.style.display = 'block';

    } catch (err: unknown) {
      progressSec.style.display = 'none';
      uploadSec.style.display = 'block';
      const msg = err instanceof Error ? err.message : 'Verification failed. Please try again.';
      showError(msg);
    }
  }

  function delay(ms: number) { return new Promise(r => setTimeout(r, ms)); }

  function safe(val: any, fallback: string = 'Not available'): string {
    if (val === null || val === undefined || val === '') return fallback;
    return String(val);
  }

  function renderResults(r: any) {
    // ── Verdict ──────────────────────────────────────────────────────────────
    const verdict = (r.verdict ?? 'UNKNOWN').toUpperCase();
    const vClass = verdict === 'AUTHENTIC' ? 'authentic'
                 : verdict === 'TAMPERED'  ? 'tampered'
                 : verdict === 'SUSPICIOUS' ? 'suspicious' : '';
    document.getElementById('verdict-container')!.innerHTML = `
      <div class="verdict-banner ${vClass}" role="status" aria-label="Verdict: ${verdict}">
        <span class="verdict-word">${verdict}</span>
        <div class="verdict-sublabel">Signature &amp; Document Integrity Verdict</div>
      </div>`;

    // ── Explainable Verification Section ─────────────────────────────────────
    const exp = r.explainable_verification ?? {};
    const conf = (exp.confidence ?? 'HIGH').toUpperCase();
    const confBadge = conf === 'HIGH' ? 'ok' : conf === 'MEDIUM' ? 'warn' : 'neutral';
    const confEl = document.getElementById('exp-confidence-badge');
    if (confEl) {
      confEl.className = `badge badge--${confBadge}`;
      confEl.textContent = `CONFIDENCE: ${conf}`;
    }

    const iconEl = document.getElementById('exp-verdict-icon');
    if (iconEl) {
      iconEl.textContent = verdict === 'AUTHENTIC' ? '✓' : verdict === 'TAMPERED' ? '✕' : '⚠';
      iconEl.style.color = verdict === 'AUTHENTIC' ? 'var(--ok)' : verdict === 'TAMPERED' ? 'var(--danger)' : 'var(--warn)';
    }

    const reasonEl = document.getElementById('exp-final-reason-text');
    if (reasonEl) {
      reasonEl.textContent = exp.final_reason || (
        verdict === 'AUTHENTIC'
          ? 'Digital signature verification succeeded and the signed content passed integrity validation.'
          : verdict === 'TAMPERED'
          ? 'Cryptographic verification failed because the signed content does not validate against the existing signature.'
          : 'The digital signature is present, but certificate, integrity, or structural checks produced warnings.'
      );
    }

    const sumEl = document.getElementById('exp-summary-text');
    if (sumEl) {
      sumEl.textContent = exp.summary || `Executive summary: Document classified as ${verdict}.`;
    }

    // Render Verification Trace
    const traceEl = document.getElementById('exp-trace-list');
    if (traceEl) {
      const steps = exp.verification_steps ?? [];
      if (steps.length === 0) {
        traceEl.innerHTML = `<div style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);color:var(--text-muted);">No trace steps recorded.</div>`;
      } else {
        traceEl.innerHTML = steps.map((st: any) => {
          const status = (st.status || 'PASS').toUpperCase();
          const sIcon = status === 'PASS' ? '✓' : status === 'FAIL' ? '✕' : status === 'WARNING' ? '⚠' : '—';
          const sColor = status === 'PASS' ? 'var(--ok)' : status === 'FAIL' ? 'var(--danger)' : status === 'WARNING' ? 'var(--warn)' : 'var(--text-muted)';
          return `
            <div style="display: flex; align-items: flex-start; justify-content: space-between; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); padding: 4px 0; border-bottom: 1px solid var(--border-subtle);">
              <div style="display: flex; align-items: flex-start; gap: 8px;">
                <span style="color: ${sColor}; font-weight: bold; flex-shrink: 0; width: 14px;">${sIcon}</span>
                <div>
                  <span style="color: var(--text-primary); font-weight: 500;">${st.check}</span>
                  ${st.observed_value ? `<span style="color: var(--text-muted); margin-left: 6px;">[${st.observed_value}]</span>` : ''}
                  ${st.explanation ? `<div style="color: var(--text-secondary); font-size: 0.6875rem; margin-top: 2px;">${st.explanation}</div>` : ''}
                </div>
              </div>
              <span class="badge badge--${status === 'PASS' ? 'ok' : status === 'FAIL' ? 'danger' : status === 'WARNING' ? 'warn' : 'neutral'}" style="font-size: 0.625rem;">
                ${status}
              </span>
            </div>
          `;
        }).join('');
      }
    }

    // Render Technical Evidence Table
    const evKv = document.getElementById('exp-evidence-kv');
    if (evKv) {
      const s = r.signature ?? {};
      const c = r.certificate ?? {};
      const intg = r.integrity ?? {};
      evKv.innerHTML = kvRows([
        ['Digest Algorithm',     safe(s.digest_algorithm, 'Not detected'), true],
        ['Signature Algorithm',  safe(s.signature_algorithm, 'Not detected'), true],
        ['Public Key Scheme',    s.public_key_algorithm ? `${s.public_key_algorithm} (${s.key_size ?? '?'} bits)` : 'Not detected', true],
        ['Certificate Trust',    safe(c.trust_status, 'UNAVAILABLE')],
        ['ByteRange Validity',   Array.isArray(intg.byte_range) && intg.byte_range.length ? 'Valid Range' : 'No Range', true],
        ['Document Integrity',   safe(intg.status, 'UNKNOWN')],
      ]);
    }

    const methEl = document.getElementById('exp-methodology-text');
    if (methEl && exp.methodology) {
      methEl.textContent = exp.methodology;
    }

    // ── Document info ─────────────────────────────────────────────────────────
    const d = r.document ?? {};
    document.getElementById('doc-info')!.innerHTML = kvRows([
      ['Filename',    safe(d.filename, 'Unknown')],
      ['File Size',   d.file_size ? formatBytes(d.file_size) : 'Unknown'],
      ['PDF Version', safe(d.pdf_version, 'Unknown')],
      ['Fingerprint', safe(d.fingerprint, 'Not available'), true],
    ]);


    // ── Digital Signature ─────────────────────────────────────────────────────
    const s = r.signature ?? {};
    const sigPresent = s.present === true;
    const sigStatus = (s.status ?? (sigPresent ? 'UNKNOWN' : 'NONE')).toUpperCase();
    const sigClass = sigStatus === 'VALID'   ? 'ok'
                   : sigStatus === 'INVALID' ? 'danger'
                   : sigStatus === 'NONE'    ? 'neutral' : 'neutral';

    const sigRows: [string, string, boolean?][] = [
      ['Present', sigPresent ? 'Yes' : 'No'],
      ['Count',   s.count != null ? String(s.count) : '0'],
      ['Status',  `<span class="badge badge--${sigClass}">${sigStatus}</span>`],
    ];
    if (s.signature_type) {
      sigRows.push(['Type', safe(s.signature_type)]);
    }
    document.getElementById('sig-info')!.innerHTML = kvRows(sigRows);

    // ── Cryptography ──────────────────────────────────────────────────────────
    const digestAlgo    = safe(s.digest_algorithm,     sigPresent ? 'Detection failed' : 'N/A — no signature');
    const sigAlgo       = safe(s.signature_algorithm,  sigPresent ? 'Detection failed' : 'N/A — no signature');
    const pubKeyAlgo    = safe(s.public_key_algorithm, sigPresent ? 'Detection failed' : 'N/A — no signature');
    const keySize       = s.key_size != null ? `${s.key_size} bits` : (sigPresent ? 'Detection failed' : 'N/A — no signature');

    document.getElementById('crypto-info')!.innerHTML = kvRows([
      ['Digest Algorithm',    digestAlgo],
      ['Signature Algorithm', sigAlgo],
      ['Public Key Algorithm',pubKeyAlgo],
      ['Key Size',            keySize],
    ]);

    // ── Certificate ──────────────────────────────────────────────────────────
    const c = r.certificate ?? {};
    const hasCert = sigPresent && (c.subject || c.issuer || c.serial_number);
    const trustStatus = (c.trust_status ?? (hasCert ? 'UNKNOWN' : 'UNAVAILABLE')).toUpperCase();
    const trustClass  = trustStatus === 'TRUSTED'     ? 'ok'
                      : trustStatus === 'SELF_SIGNED'  ? 'warn'
                      : trustStatus === 'UNTRUSTED'   ? 'danger'
                      : trustStatus === 'EXPIRED'     ? 'danger' : 'neutral';
    document.getElementById('cert-info')!.innerHTML = kvRows([
      ['Subject',     hasCert ? safe(c.subject, 'Not available') : (sigPresent ? 'Not extracted' : 'N/A — no signature')],
      ['Issuer',      hasCert ? safe(c.issuer,  'Not available') : (sigPresent ? 'Not extracted' : 'N/A — no signature')],
      ['Serial',      hasCert ? safe(c.serial_number, 'Not available') : (sigPresent ? 'Not extracted' : 'N/A — no signature'), true],
      ['Valid From',  hasCert ? safe(c.valid_from,  'Not available') : (sigPresent ? 'Not extracted' : 'N/A — no signature')],
      ['Valid Until', hasCert ? safe(c.valid_until, 'Not available') : (sigPresent ? 'Not extracted' : 'N/A — no signature')],
      ['Trust Status', `<span class="badge badge--${trustClass}">${trustStatus}</span>`],
    ]);

    // ── Integrity ─────────────────────────────────────────────────────────────
    const intg = r.integrity ?? {};
    const intStatus = (intg.status ?? 'UNKNOWN').toUpperCase();
    const intClass  = intStatus === 'VERIFIED' ? 'ok'
                    : intStatus === 'FAILED'   ? 'danger' : 'neutral';
    document.getElementById('integrity-info')!.innerHTML = kvRows([
      ['Status',       `<span class="badge badge--${intClass}">${intStatus}</span>`],
      ['Modification', safe(intg.modification_status, 'Unknown')],
      ['ByteRange',    Array.isArray(intg.byte_range) && intg.byte_range.length
                         ? intg.byte_range.join(', ')
                         : 'Not available', true],
    ]);

    // ── Duplicate ─────────────────────────────────────────────────────────────
    const dup = r.duplicate ?? {};
    const isDup = Boolean(dup.is_duplicate) ||
      (r.verdict && r.verdict.toUpperCase() === 'TAMPERED') ||
      (intg.status && intg.status.toUpperCase() === 'FAILED') ||
      (intg.modification_status && intg.modification_status.toUpperCase() === 'MODIFIED');
    const matchType = isDup
      ? (dup.match_type && dup.match_type !== 'NONE' ? dup.match_type : 'TAMPERED_DUPLICATE')
      : safe(dup.match_type, 'None');

    document.getElementById('dup-info')!.innerHTML = kvRows([
      ['Is Duplicate', isDup ? 'Yes' : 'No'],
      ['Match Type',   matchType],
    ]);

    // ── Certificate & Public Key Inspector ─────────────────────────────────────
    renderCertificateInspector(r);

    // ── Security link ─────────────────────────────────────────────────────────
    if (r.analysis_id) {
      const secLink = document.getElementById('security-link') as HTMLAnchorElement;
      secLink.href = `/security?id=${r.analysis_id}`;
      secLink.style.display = 'inline-flex';
    }
  }

  function renderCertificateInspector(r: any) {
    const insp = r.certificate_inspection ?? {};
    const cert = insp.certificate ?? {};
    const pk = insp.public_key ?? {};
    const val = insp.validity ?? {};
    const trust = insp.trust ?? {};
    const fp = insp.fingerprint ?? {};
    const sec = insp.security_assessment ?? {};
    const chain = insp.chain ?? [];
    const exts = insp.extensions ?? [];
    const findings = insp.findings ?? [];

    const valStatus = (val.status ?? 'UNKNOWN').toUpperCase();
    const valClass = valStatus === 'VALID' ? 'ok' : valStatus === 'EXPIRED' ? 'danger' : valStatus === 'NOT_YET_VALID' ? 'warn' : 'neutral';
    const statusBadge = document.getElementById('cert-status-badge');
    if (statusBadge) {
      statusBadge.className = `badge badge--${valClass}`;
      statusBadge.textContent = `STATUS: ${valStatus}`;
    }

    const trustStatus = (trust.status ?? 'UNKNOWN').toUpperCase();
    const trustClass = trustStatus === 'TRUSTED' ? 'ok' : trustStatus === 'SELF_SIGNED' ? 'warn' : trustStatus === 'UNTRUSTED' ? 'danger' : 'neutral';
    const trustBadge = document.getElementById('cert-trust-badge');
    if (trustBadge) {
      trustBadge.className = `badge badge--${trustClass}`;
      trustBadge.textContent = `TRUST: ${trustStatus}`;
    }

    const keyStrength = (sec.key_strength ?? 'UNKNOWN').toUpperCase();
    const keyClass = keyStrength === 'ACCEPTABLE' ? 'ok' : keyStrength === 'WEAK' ? 'danger' : 'neutral';
    const keyBadge = document.getElementById('key-strength-badge');
    if (keyBadge) {
      keyBadge.className = `badge badge--${keyClass}`;
      keyBadge.textContent = `KEY: ${keyStrength}`;
    }

    // Identity KV
    const idKv = document.getElementById('cert-identity-kv');
    if (idKv) {
      const subj = cert.subject ?? {};
      const issu = cert.issuer ?? {};
      idKv.innerHTML = kvRows([
        ['Subject CN', safe(typeof subj === 'object' ? subj.common_name : subj, 'Not available')],
        ['Organization', safe(typeof subj === 'object' ? subj.organization : null, 'None / Unspecified')],
        ['Org Unit', safe(typeof subj === 'object' ? subj.organizational_unit : null, 'None')],
        ['Country / State', `${safe(typeof subj === 'object' ? subj.country : null, '—')} / ${safe(typeof subj === 'object' ? subj.state : null, '—')}`],
        ['Issuer CN', safe(typeof issu === 'object' ? issu.common_name : issu, 'Not available')],
        ['Issuer Org', safe(typeof issu === 'object' ? issu.organization : null, 'None / Unspecified')],
        ['Serial Number', safe(cert.serial_number, 'Not available'), true],
        ['Self-Signed', cert.is_self_signed === true ? 'Yes' : cert.is_self_signed === false ? 'No' : 'Unknown'],
      ]);
    }

    // Crypto KV
    const cryptoKv = document.getElementById('cert-crypto-kv');
    if (cryptoKv) {
      cryptoKv.innerHTML = kvRows([
        ['Key Algorithm', safe(pk.algorithm, 'Not available'), true],
        ['Key Size / Curve', pk.curve ? `${pk.curve} (${pk.key_size ?? '?'} bits)` : pk.key_size ? `${pk.key_size} bits` : 'Not available', true],
        ['Public Exponent', pk.exponent ? `${pk.exponent} (0x${pk.exponent.toString(16).toUpperCase()})` : 'N/A', true],
        ['Cert Signature', safe(cert.signature_algorithm, 'Not available'), true],
        ['Doc Signature', safe(r.signature?.signature_algorithm, 'Not available'), true],
        ['Digest Algorithm', safe(r.signature?.digest_algorithm, 'Not available'), true],
        ['Validity Start', safe(val.not_before, 'Not available')],
        ['Validity End', safe(val.not_after, 'Not available')],
      ]);
    }

    // Extensions & Fingerprint KV
    const extKv = document.getElementById('cert-extensions-kv');
    if (extKv) {
      const ku = exts.find((e: any) => e.name?.toLowerCase().includes('keyusage') && !e.name?.toLowerCase().includes('extended'));
      const eku = exts.find((e: any) => e.name?.toLowerCase().includes('extendedkeyusage'));
      const san = exts.find((e: any) => e.name?.toLowerCase().includes('altname') || e.name?.toLowerCase().includes('alternativename'));
      const bc = exts.find((e: any) => e.name?.toLowerCase().includes('basicconstraints'));

      extKv.innerHTML = kvRows([
        ['SHA-256 Fingerprint', safe(fp.value, 'Not available'), true],
        ['Key Usage', safe(ku?.value, 'Not specified')],
        ['Extended Key Usage', safe(eku?.value, 'None')],
        ['Basic Constraints', safe(bc?.value, 'None')],
        ['Subject Alt Name', safe(san?.value, 'None')],
        ['Extensions Total', exts.length ? String(exts.length) : 'None'],
      ]);
    }

    // Certificate Chain Trace
    const chainList = document.getElementById('cert-chain-list');
    if (chainList) {
      if (!chain || chain.length === 0) {
        chainList.innerHTML = `<div style="font-family:'IBM Plex Mono',monospace;font-size:var(--text-xs);color:var(--text-muted);">No certificate chain available.</div>`;
      } else {
        chainList.innerHTML = chain.map((node: any, idx: number) => {
          const role = (node.role || 'SIGNER').toUpperCase();
          const roleBadge = role === 'SIGNER' ? 'accent' : role === 'ROOT_CA' ? 'ok' : 'warn';
          return `
            <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); padding: 6px 0; border-bottom: 1px solid var(--border-subtle);">
              <div style="display: flex; align-items: center; gap: 8px;">
                <span style="color: var(--text-muted); font-size: 0.75rem;">${idx === 0 ? '↳' : '↓'}</span>
                <div>
                  <span style="color: var(--text-primary); font-weight: 600;">${safe(node.subject, 'Unknown Cert')}</span>
                  ${node.serial_number ? `<div style="color: var(--text-muted); font-size: 0.6875rem;">SN: ${node.serial_number}</div>` : ''}
                </div>
              </div>
              <span class="badge badge--${roleBadge}" style="font-size: 0.625rem;">
                ${role}
              </span>
            </div>
          `;
        }).join('');
      }
    }

    // Security Findings List
    const findingsList = document.getElementById('cert-findings-list');
    if (findingsList) {
      if (!findings || findings.length === 0) {
        findingsList.innerHTML = `
          <div style="display: flex; align-items: center; gap: 8px; font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); color: var(--ok); padding: 8px 0;">
            <span>✓</span>
            <span>No certificate security policy violations detected.</span>
          </div>
        `;
      } else {
        findingsList.innerHTML = findings.map((f: any) => {
          const sev = (f.severity || 'INFO').toUpperCase();
          const sevBadge = sev === 'HIGH' ? 'danger' : sev === 'MEDIUM' ? 'warn' : 'neutral';
          return `
            <div style="padding: 6px 8px; background: var(--bg-surface); border: 1px solid var(--border-subtle); border-radius: 4px;">
              <div style="display: flex; align-items: center; justify-content: space-between; gap: 8px; margin-bottom: 4px;">
                <span style="font-family: 'IBM Plex Mono', monospace; font-size: var(--text-xs); font-weight: 600; color: var(--text-primary);">${f.title}</span>
                <span class="badge badge--${sevBadge}" style="font-size: 0.625rem;">${sev}</span>
              </div>
              <div style="font-size: 0.6875rem; color: var(--text-secondary); line-height: 1.4;">${f.description}</div>
            </div>
          `;
        }).join('');
      }
    }
  }

  function kvRows(pairs: [string, string, boolean?][]): string {
    return pairs.map(([k, v, isMono]) =>
      `<dt class="kv-key">${k}</dt><dd class="kv-value${isMono ? ' mono' : ''}">${v}</dd>`
    ).join('');
  }

  function formatBytes(bytes: number): string {
    if (bytes < 1024) return bytes + ' B';
    if (bytes < 1048576) return (bytes / 1024).toFixed(1) + ' KB';
    return (bytes / 1048576).toFixed(1) + ' MB';
  }

  function showError(msg: string) {
    uploadErr.textContent = msg;
    uploadErr.style.display = 'block';
  }

  function clearError() {
    uploadErr.textContent = '';
    uploadErr.style.display = 'none';
  }

  function resetUI() {
    resultsSec.style.display = 'none';
    uploadSec.style.display = 'block';
    fileInput.value = '';
    clearError();
  }
</script>

<style>
  .results-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: var(--space-6);
    align-items: start;
  }

  .results-col {
    display: flex;
    flex-direction: column;
  }

  .file-info {
    font-family: 'IBM Plex Mono', monospace;
    font-size: var(--text-xs);
    color: var(--text-secondary);
    margin-top: var(--space-3);
  }

  @media (max-width: 900px) {
    .results-grid { grid-template-columns: 1fr; }
  }
</style>
