---
/**
 * Navigation sidebar component.
 * In-app navigation allows natural history back/forward (undo).
 */
const currentPath = Astro.url.pathname;

const dashboardLinks = [
  { href: '/',          label: 'Home',              icon: 'home' },
  { href: '/dashboard', label: 'Dashboard',         icon: 'grid' },
  { href: '/verify',    label: 'Verify Document',   icon: 'shield' },
  { href: '/security',  label: 'Security Analysis', icon: 'alert' },
];

const systemLinks = [
  { href: '/analysis', label: 'Analysis History', icon: 'clock' },
];

function isActive(href: string): boolean {
  if (href === '/') return currentPath === '/';
  return currentPath === href || currentPath.startsWith(href + '/');
}
---

<nav class="sidebar" aria-label="Main navigation">
  <!-- Brand (Links to Home) -->
  <a href="/" class="nav-brand" title="QuantumTrust Home">
    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" class="brand-icon">
      <path d="M 5.5 12.2 C 5.5 7.6, 8.4 4.5, 12 4.5 C 15.6 4.5, 17.5 6.7, 17.5 8.4"/>
      <path d="M 9.8 8.4 C 10.8 7.4, 12.7 7.4, 14.4 8.6 C 15.8 10.1, 16.3 12.5, 16.3 14.9"/>
      <path d="M 5.3 14.8 L 5.31 14.8"/>
      <path d="M 8.2 10.3 C 7.9 12.7, 7.7 15.1, 7.2 17.3"/>
      <path d="M 10.1 10.8 C 10.1 12.5, 10.3 13.4, 10.3 14.9"/>
      <path d="M 9.8 19 L 10.3 17"/>
      <path d="M 12.2 10.3 C 13 10.6, 13.2 11.5, 13.2 13.4 L 13.2 16.1 C 13.2 17.3, 13 18, 13 19"/>
      <path d="M 15.8 15.8 C 15.6 16.8, 15.6 17.5, 15.6 18.2"/>
      <path d="M 18.7 10.6 L 18.7 14.9"/>
    </svg>
    <div>
      <div class="brand-name">QuantumTrust</div>
      <div class="brand-sub">Signature Security</div>
    </div>
  </a>

  <div class="nav-divider"></div>

  <!-- Dashboard links -->
  <div class="nav-section">
    <div class="nav-section-label">Dashboards</div>
    {dashboardLinks.map(link => (
      <a
        href={link.href}
        class={`nav-item ${isActive(link.href) ? 'active' : ''}`}
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        <span class="nav-icon" aria-hidden="true">
          {link.icon === 'home' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
              <polyline points="9 22 9 12 15 12 15 22"/>
            </svg>
          )}
          {link.icon === 'grid' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <rect x="3" y="3" width="7" height="7"/><rect x="14" y="3" width="7" height="7"/>
              <rect x="14" y="14" width="7" height="7"/><rect x="3" y="14" width="7" height="7"/>
            </svg>
          )}
          {link.icon === 'shield' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M12 22s8-4 8-10V5l-8-3-8 3v7c0 6 8 10 8 10z"/>
            </svg>
          )}
          {link.icon === 'alert' && (
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M10.29 3.86L1.82 18a2 2 0 001.71 3h16.94a2 2 0 001.71-3L13.71 3.86a2 2 0 00-3.42 0z"/>
              <line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/>
            </svg>
          )}
        </span>
        {link.label}
      </a>
    ))}
  </div>

  <div class="nav-divider"></div>

  <!-- System links -->
  <div class="nav-section">
    <div class="nav-section-label">System</div>
    {systemLinks.map(link => (
      <a
        href={link.href}
        class={`nav-item ${isActive(link.href) ? 'active' : ''}`}
        aria-current={isActive(link.href) ? 'page' : undefined}
      >
        <span class="nav-icon" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/><polyline points="12 6 12 12 16 14"/>
          </svg>
        </span>
        {link.label}
      </a>
    ))}
  </div>

  <!-- Private key notice -->
  <div class="nav-footer">
    <div class="private-key-notice">
      <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
        <rect x="3" y="11" width="18" height="11" rx="2" ry="2"/>
        <path d="M7 11V7a5 5 0 0110 0v4"/>
      </svg>
      QuantumTrust never requires your private key for document verification.
    </div>
  </div>
</nav>

<style>
  .nav-brand {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 20px 16px 16px;
    text-decoration: none;
  }

  .nav-brand:hover .brand-name {
    color: var(--text-primary);
  }

  .brand-icon {
    flex-shrink: 0;
    color: var(--text-primary);
  }

  .brand-name {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-primary);
    line-height: 1.2;
  }

  .brand-sub {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-weight: 600;
    line-height: 1;
    margin-top: 2px;
  }

  .nav-divider {
    border-top: 1px solid var(--border);
    margin: 4px 0;
  }

  .nav-section {
    padding: 8px 0;
  }

  .nav-section-label {
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.6875rem;
    color: var(--text-muted);
    font-weight: 700;
    padding: 4px 16px 6px;
    letter-spacing: 0.05em;
    text-transform: uppercase;
  }

  .nav-item {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 9px 16px;
    font-family: 'Inter', sans-serif;
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--text-secondary);
    text-decoration: none;
    border-left: 3px solid transparent;
    transition: background var(--transition), color var(--transition), border-color var(--transition);
  }

  .nav-item:hover {
    background: var(--bg-hover);
    color: var(--text-primary);
  }

  .nav-item.active {
    color: var(--text-primary);
    background: var(--bg-active);
    border-left-color: var(--accent);
  }

  .nav-icon {
    display: flex;
    align-items: center;
    flex-shrink: 0;
    color: inherit;
  }

  .nav-footer {
    margin-top: auto;
    padding: 12px 16px 16px;
  }

  .private-key-notice {
    display: flex;
    align-items: flex-start;
    gap: 6px;
    font-family: 'IBM Plex Mono', monospace;
    font-size: 0.625rem;
    color: var(--text-muted);
    line-height: 1.4;
    padding: 8px;
    background: var(--bg-raised);
    border: 1px solid var(--border-subtle);
    border-radius: 3px;
  }

  .private-key-notice svg {
    flex-shrink: 0;
    margin-top: 2px;
  }
</style>
